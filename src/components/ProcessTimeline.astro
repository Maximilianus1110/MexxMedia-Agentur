---
interface Step {
  step: number;
  title: string;
  subtitle: string;
  description: string;
  icon?: string;
}

interface Props {
  steps?: Step[];
}

const defaultSteps = [
  {
    step: 1,
    title: "Erstgespräch & Analyse",
    subtitle: "Ziele & Anforderungen",
    description: "Wir lernen Ihr Projekt kennen und analysieren gemeinsam Ihre spezifischen Anforderungen und Ziele.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z" />
          </svg>`
  },
  {
    step: 2,
    title: "Konzept & Design",
    subtitle: "Strategie & visuelle Identität",
    description: "Entwicklung einer maßgeschneiderten Struktur mit UX-Fokus und einzigartigem Wiedererkennungswert.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>`
  },
  {
    step: 3,
    title: "Entwicklung",
    subtitle: "Technische Umsetzung",
    description: "Professionelle Implementierung mit modernsten Technologien und regelmäßigen Feedback-Schleifen.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>`
  },
  {
    step: 4,
    title: "Go-Live",
    subtitle: "Launch & Optimierung",
    description: "Sorgfältig geplanter Launch mit umfangreichen Tests und Performance-Optimierung.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>`
  },
  {
    step: 5,
    title: "Support",
    subtitle: "Betreuung & Wartung",
    description: "Kontinuierliche Betreuung, Updates und Support für nachhaltigen Erfolg.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M18.364 5.636l-3.536 3.536m0 5.656l3.536 3.536M9.172 9.172L5.636 5.636m3.536 9.192l-3.536 3.536M21 12a9 9 0 11-18 0 9 9 0 0118 0zm-5 0a4 4 0 11-8 0 4 4 0 018 0z" />
          </svg>`
  }
];

const { steps = defaultSteps } = Astro.props;
---

<div class="relative max-w-5xl mx-auto py-16">
  <!-- Timeline Line -->
  <div class="absolute left-5 md:left-1/2 top-0 bottom-0 w-[3px] bg-gradient-to-b from-primary-400 to-primary-600 blur-[0.5px] animate-pulse"></div>

  <!-- Timeline Steps -->
  <div class="relative space-y-16">
    {steps.map((step, index) => (
      <div 
        class={`relative grid md:grid-cols-2 gap-8 items-center ${
          index % 2 === 0 ? 'md:text-right' : 'md:text-left'
        }`}
        data-aos={index % 2 === 0 ? 'fade-right' : 'fade-left'}
        data-aos-delay={100 + (index * 50)}
      >
        <!-- Step Badge -->
        <div 
          class={`absolute left-5 -translate-x-1/2 z-10 md:left-1/2 ${
            index % 2 === 0 ? 'md:-translate-x-1/2' : 'md:-translate-x-1/2'
          }`}
        >
          <div class="w-10 h-10 rounded-full bg-primary-600 text-white shadow-lg 
                      flex items-center justify-center ring-4 ring-primary-100 dark:ring-primary-900
                      transition-all duration-300 hover:scale-110">
            <div class="text-white" set:html={step.icon} />
          </div>
        </div>

        <!-- Content -->
        <div class={`md:col-span-1 ${
          index % 2 === 0 ? 'md:col-start-1' : 'md:col-start-2'
        }`}>
          <div class={`bg-white dark:bg-neutral-900 rounded-xl p-6 shadow-lg
                       border border-neutral-200/50 dark:border-neutral-800/50
                       transition-all duration-300 hover:-translate-y-1 hover:shadow-xl
                       ${index % 2 === 0 ? 'ml-12 md:ml-0' : 'ml-12 md:ml-0'}`}>
            <span class="inline-block px-3 py-1 rounded-full text-xs font-medium bg-primary-100 dark:bg-primary-900 text-primary-700 dark:text-primary-300 mb-3">
              Schritt {step.step}
            </span>
            <h3 class="font-clash text-xl text-neutral-900 dark:text-white">
              {step.title}
            </h3>
            <p class="text-sm text-neutral-500 dark:text-neutral-400 mt-1">
              {step.subtitle}
            </p>
            <p class="text-base mt-2 text-neutral-700 dark:text-neutral-300">
              {step.description}
            </p>
          </div>
        </div>
      </div>
    ))}
  </div>
</div> 
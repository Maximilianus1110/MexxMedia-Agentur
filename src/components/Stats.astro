---
interface Stat {
  value: number;
  label: string;
  prefix?: string;
  suffix?: string;
}

interface Props {
  stats?: Stat[];
}

const defaultStats: Stat[] = [
  {
    value: 50,
    label: "Ziel: glückliche Kunden",
    suffix: "+"
  },
  {
    value: 30,
    label: "geplante Projekte",
    suffix: "+"
  },
  {
    value: 5,
    label: "Jahre Erfahrung",
    suffix: "+"
  }
];

const { stats = defaultStats } = Astro.props;
---

<section class="py-24 bg-neutral-50 dark:bg-neutral-900/50">
  <div class="container mx-auto px-4">
    <div class="grid md:grid-cols-3 gap-12 max-w-5xl mx-auto">
      {stats.map((stat, index) => (
        <div 
          class="text-center"
          data-aos="fade-up"
          data-aos-delay={index * 100}
        >
          <div class="flex items-center justify-center gap-1 mb-4">
            {stat.prefix && (
              <span class="text-4xl md:text-5xl font-clash font-bold text-primary-600 dark:text-primary-400">
                {stat.prefix}
              </span>
            )}
            <span 
              class="counter text-4xl md:text-5xl font-clash font-bold text-primary-600 dark:text-primary-400"
              data-target={stat.value}
            >
              0
            </span>
            {stat.suffix && (
              <span class="text-4xl md:text-5xl font-clash font-bold text-primary-600 dark:text-primary-400">
                {stat.suffix}
              </span>
            )}
          </div>
          <p class="text-sm md:text-base text-neutral-600 dark:text-neutral-400">
            {stat.label}
          </p>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  function animateCounter(counter: HTMLElement, target: number, duration: number = 2000) {
    const start = 0;
    const increment = target / (duration / 16); // 60fps
    let current = start;

    const animate = () => {
      current += increment;
      counter.textContent = Math.floor(current).toString();

      if (current < target) {
        requestAnimationFrame(animate);
      } else {
        counter.textContent = target.toString();
      }
    };

    animate();
  }

  // Initialize counters when they come into view
  const observer = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const counter = entry.target as HTMLElement;
        const target = parseInt(counter.getAttribute('data-target') || '0', 10);
        animateCounter(counter, target);
        observer.unobserve(counter);
      }
    });
  }, {
    threshold: 0.5
  });

  // Observe all counter elements
  document.querySelectorAll('.counter').forEach(counter => {
    observer.observe(counter);
  });
</script> 
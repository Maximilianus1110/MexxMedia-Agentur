---
const problems = [
  {
    id: 'outdated',
    tab: 'Veraltete Website',
    title: 'Ihre Website ist nicht mehr zeitgemäß?',
    description: 'Eine veraltete Website schreckt potenzielle Kunden ab und schadet Ihrem Image. Langsame Ladezeiten, schlechte mobile Darstellung und ein unmodernes Design führen zu hohen Absprungraten.',
    points: [ 'Schlechtes Nutzererlebnis', 'Nicht für Mobilgeräte optimiert', 'Verpasste Geschäftschancen' ]
  },
  {
    id: 'invisible',
    tab: 'Nicht auffindbar',
    title: 'Werden Sie online nicht gefunden?',
    description: 'Ohne eine starke Präsenz in Suchmaschinen wie Google existieren Sie für viele potenzielle Kunden nicht. Schlechte Rankings bedeuten weniger Traffic und somit weniger Anfragen.',
    points: [ 'Niedrige Besucherzahlen', 'Konkurrenz ist sichtbarer', 'Kein organisches Wachstum' ]
  },
  {
    id: 'no-leads',
    tab: 'Keine Anfragen',
    title: 'Generiert Ihre Website keine Kontakte?',
    description: 'Ihre Website ist oft der erste Kontaktpunkt. Wenn sie Besucher nicht überzeugt und zu einer Handlung motiviert, verlieren Sie wertvolle Leads an Ihre Mitbewerber.',
    points: [ 'Unklare Handlungsaufforderungen', 'Geringe Conversion-Rate', 'Mangelndes Vertrauen' ]
  }
];

const solutions = [
  {
    id: 'outdated',
    title: 'Modernes & schnelles Webdesign',
    description: 'Wir erstellen eine blitzschnelle, mobil-optimierte Website mit modernem Design, die Ihre Besucher begeistert und Ihr Unternehmen professionell repräsentiert.',
    points: [ 'Individuelles, ansprechendes Design', 'Optimale Darstellung auf allen Geräten', 'Hervorragende Ladezeiten' ]
  },
  {
    id: 'invisible',
    title: 'Strategische SEO',
    description: 'Mit gezielter Suchmaschinenoptimierung sorgen wir dafür, dass Ihre Zielgruppe Sie genau dann findet, wenn sie nach Ihren Dienstleistungen sucht.',
    points: [ 'Top-Positionen bei Google', 'Mehr qualifizierter Traffic', 'Nachhaltige Sichtbarkeit' ]
  },
  {
    id: 'no-leads',
    title: 'Conversion-Optimierung',
    description: 'Durch klare Nutzerführung, überzeugende Inhalte und strategisch platzierte Call-to-Actions verwandeln wir Ihre Website-Besucher in zahlende Kunden.',
    points: [ 'Steigerung der Anfragen', 'Verbesserte Nutzerführung', 'Messbarer Erfolg' ]
  }
];
---

<section id="problem-solution" class="py-24 md:py-32">
  <div class="container mx-auto px-4">
    <!-- Section Header -->
    <div class="text-center mb-16">
      <h2 class="font-display text-4xl md:text-5xl font-bold text-neutral-800 dark:text-white mb-4">
        Vom Problem zur Lösung
      </h2>
      <p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-3xl mx-auto">
        Kennen Sie das? Wir haben die Lösung.
      </p>
    </div>

    <!-- Alpine.js Component Root -->
    <div x-data={`{
      problems: ${JSON.stringify(problems)},
      solutions: ${JSON.stringify(solutions)},
      activeTab: 'outdated',
      get activeIndex() { return this.problems.findIndex(p => p.id === this.activeTab) },
      next() {
        const newIndex = (this.activeIndex + 1) % this.problems.length;
        this.activeTab = this.problems[newIndex].id;
      },
      init() {
        setInterval(() => { this.next() }, 5000);
      }
    }`.replace(/"/g, "'")} x-init="init()">

      <!-- Tabs -->
      <div class="flex justify-center mb-12 relative">
        <div class="flex items-center justify-center bg-neutral-100 dark:bg-neutral-800/50 rounded-full p-1.5">
          <template x-for="problem in problems" :key="problem.id">
            <button
              class="px-6 py-3 rounded-full text-sm font-medium transition-all duration-300"
              :class="activeTab === problem.id ? 'bg-primary-600 text-white shadow-md' : 'text-neutral-600 dark:text-neutral-400 hover:bg-neutral-200 dark:hover:bg-neutral-700'"
              @click="activeTab = problem.id"
              x-text="problem.tab">
            </button>
          </template>
        </div>
      </div>

      <!-- Slides Container -->
      <div class="relative overflow-hidden">
        <div class="flex transition-transform duration-500 ease-in-out" :style="\`transform: translateX(-\${activeIndex * 100}%)\`">
          <template x-for="problem in problems" :key="problem.id">
            <div class="w-full flex-shrink-0">
              <div class="grid md:grid-cols-2 gap-8 md:gap-16 items-center">
                
                <!-- Problem Side -->
                <div class="space-y-4">
                  <h3 class="font-display text-2xl font-bold text-neutral-800 dark:text-white" x-text="problem.title"></h3>
                  <p class="text-neutral-600 dark:text-neutral-300" x-text="problem.description"></p>
                  <ul class="space-y-2">
                    <template x-for="point in problem.points" :key="point">
                      <li class="flex items-start">
                        <svg class="w-5 h-5 mr-3 mt-1 text-red-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                        <span x-text="point"></span>
                      </li>
                    </template>
                  </ul>
                </div>

                <!-- Solution Side -->
                <div class="bg-gradient-to-br from-primary-50 to-blue-100 dark:from-neutral-900 dark:to-primary-900/20 p-8 rounded-2xl space-y-4">
                   <template x-for="solution in solutions.filter(s => s.id === problem.id)" :key="solution.id">
                    <div>
                      <h3 class="font-display text-2xl font-bold text-neutral-800 dark:text-white" x-text="solution.title"></h3>
                      <p class="text-neutral-600 dark:text-neutral-300" x-text="solution.description"></p>
                      <ul class="space-y-2">
                        <template x-for="point in solution.points" :key="point">
                           <li class="flex items-start">
                            <svg class="w-5 h-5 mr-3 mt-1 text-green-500 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
                            <span x-text="point"></span>
                          </li>
                        </template>
                      </ul>
                    </div>
                   </template>
                </div>

              </div>
            </div>
          </template>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
</style>
---
interface Problem {
  icon: string;
  title: string;
  description: string;
  solution: string;
  solutionTitle: string;
}

const problems: Problem[] = [
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>`,
    title: "Veraltete Webseite",
    description: "Ihre aktuelle Webseite entspricht nicht mehr den modernen Standards und verliert wertvolle Besucher.",
    solution: "Wir entwickeln eine moderne, schnelle und benutzerfreundliche Webseite, die Ihre Besucher begeistert.",
    solutionTitle: "Moderne Webentwicklung"
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>`,
    title: "Schlechte Sichtbarkeit",
    description: "Potenzielle Kunden finden Sie nicht in den Suchergebnissen von Google & Co.",
    solution: "Mit unserer SEO-Expertise verbessern wir Ihr Ranking und machen Sie sichtbar für Ihre Zielgruppe.",
    solutionTitle: "SEO Optimierung"
  },
  {
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-8 h-8" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
          </svg>`,
    title: "Mangelnde Conversion",
    description: "Ihre Webseite generiert zu wenig Anfragen und Neukunden.",
    solution: "Durch optimierte User Experience und strategische Call-to-Actions steigern wir Ihre Conversion-Rate.",
    solutionTitle: "Conversion Optimierung"
  }
];
---

<section class="py-24 relative bg-gradient-to-b from-white to-neutral-50 dark:from-neutral-950 dark:to-black">
  <!-- Decorative elements -->
  <div class="absolute inset-0 overflow-hidden">
    <div class="absolute w-[500px] h-[500px] -right-40 -top-40 rounded-full bg-[#C4A47D]/5"></div>
    <div class="absolute w-[500px] h-[500px] -left-40 -bottom-40 rounded-full bg-[#8B6B47]/5"></div>
  </div>

  <div class="container mx-auto px-4 relative">
    <!-- Section Header -->
    <div class="text-center mb-20">
      <div class="inline-block" data-aos="fade-up">
        <p class="text-[#C4A47D] font-medium tracking-wide uppercase text-sm mb-4 
                  bg-[#2C2620] px-4 py-2 rounded-full">
          Ihre Herausforderungen
        </p>
      </div>
      <h2 class="text-4xl md:text-5xl font-serif font-bold mb-6 
                 bg-gradient-to-r from-[#C4A47D] to-[#8B6B47] bg-clip-text text-transparent"
          data-aos="fade-up" data-aos-delay="100">
        Kennen Sie diese Probleme?
      </h2>
      <p class="text-lg text-neutral-600 dark:text-neutral-400 max-w-2xl mx-auto"
         data-aos="fade-up" data-aos-delay="200">
        Viele Unternehmen kämpfen mit ähnlichen Herausforderungen. Wir haben die Lösungen.
      </p>
    </div>

    <!-- Problems Grid -->
    <div class="grid md:grid-cols-3 gap-8">
      {problems.map((problem, index) => (
        <div class="group relative" data-aos="fade-up" data-aos-delay={index * 100}>
          <!-- Card -->
          <div class="h-full rounded-2xl p-8 relative overflow-hidden
                      bg-white dark:bg-neutral-900
                      border border-neutral-200/50 dark:border-neutral-800
                      transition-all duration-500
                      hover:border-[#C4A47D]/30 hover:shadow-xl hover:shadow-[#C4A47D]/5">
            
            <!-- Icon -->
            <div class="w-14 h-14 rounded-xl bg-gradient-to-br from-[#C4A47D] to-[#8B6B47]
                        flex items-center justify-center mb-6
                        transform transition-transform duration-500
                        group-hover:scale-110 group-hover:rotate-3">
              <Fragment set:html={problem.icon} />
            </div>

            <!-- Content -->
            <div class="space-y-4">
              <h3 class="text-xl font-bold text-neutral-900 dark:text-white
                         group-hover:text-[#C4A47D] transition-colors duration-300">
                {problem.title}
              </h3>
              <p class="text-neutral-600 dark:text-neutral-400">
                {problem.description}
              </p>
            </div>

            <!-- Solution -->
            <div class="mt-6 pt-6 border-t border-neutral-200/50 dark:border-neutral-800">
              <div class="flex items-start gap-3">
                <div class="flex-shrink-0 w-8 h-8 rounded-full bg-[#2C2620] 
                           flex items-center justify-center">
                  <svg xmlns="http://www.w3.org/2000/svg" class="w-4 h-4 text-[#C4A47D]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
                  </svg>
                </div>
                <div>
                  <h4 class="font-semibold text-[#C4A47D] mb-2">
                    {problem.solutionTitle}
                  </h4>
                  <p class="text-sm text-neutral-600 dark:text-neutral-400">
                    {problem.solution}
                  </p>
                </div>
              </div>
            </div>

            <!-- Decorative gradient -->
            <div class="absolute inset-0 bg-gradient-to-br from-[#C4A47D]/0 to-[#8B6B47]/0
                        transition-opacity duration-500 opacity-0
                        group-hover:opacity-5"></div>
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-16 text-center" data-aos="fade-up">
      <a href="#contact" 
         class="inline-flex items-center gap-2 px-8 py-4 rounded-xl
                bg-gradient-to-r from-[#C4A47D] to-[#8B6B47] 
                text-white font-medium
                transform transition-all duration-300
                hover:scale-105 hover:shadow-lg hover:shadow-[#C4A47D]/20">
        <span>Jetzt Gespräch vereinbaren</span>
        <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
    </div>
  </div>
</section>

<style>
  .premium-card {
    position: relative;
    border-radius: 1rem;
    overflow: visible;
  }

  .premium-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 200%;
    height: 100%;
    background: linear-gradient(
      115deg,
      transparent,
      transparent 40%,
      rgba(196, 164, 125, 0.05) 45%,
      rgba(196, 164, 125, 0.05) 55%,
      transparent 60%,
      transparent
    );
    transition: transform 0.7s ease;
  }

  .premium-card:hover::before {
    transform: translateX(50%);
  }
</style> 
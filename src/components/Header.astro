---
import { Image } from 'astro:assets';
import ThemeToggle from './ThemeToggle.astro';
---

<header class="fixed w-full top-0 z-50 transition-all duration-300 ease-in-out bg-white/80 dark:bg-neutral-950/80 backdrop-blur-lg border-b border-gray-200 dark:border-neutral-900">
  <div class="container mx-auto px-4">
    <nav class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex items-center space-x-2">
        <span class="font-playfair font-bold text-xl tracking-wider">mexxmedia</span>
      </a>

      <!-- Navigation Links -->
      <div class="hidden md:flex items-center space-x-8">
        <a href="/" class="font-body text-neutral-700 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300">
          Home
        </a>
        <a href="/service" class="font-body text-neutral-700 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300">
          Services
        </a>
        <a href="/about" class="font-body text-neutral-700 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300">
          Über uns
        </a>
      
        <a href="#contact" class="font-body text-neutral-700 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300">
          Kontakt
        </a>
      </div>

      <!-- CTA & Theme Toggle -->
      <div class="flex items-center space-x-4">
        <a 
          href="/contact" 
          class="hidden md:inline-flex px-4 py-2 rounded-lg font-body text-white bg-primary-600 hover:bg-primary-700 transition-all duration-300 ease-in-out hover:shadow-glow-sm"
        >
          Get Started
        </a>
        <ThemeToggle />
        
        <!-- Mobile Menu Button -->
        <button 
          id="menuButton"
          class="md:hidden p-2 rounded-lg text-neutral-700 dark:text-neutral-300 hover:bg-neutral-100 dark:hover:bg-neutral-900 transition-colors duration-300"
          aria-label="Toggle Menu"
        >
          <svg xmlns="http://www.w3.org/2000/svg" class="h-6 w-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
          </svg>
        </button>
      </div>
    </nav>

    <!-- Mobile Menu -->
    <div 
      id="mobileMenu" 
      class="hidden md:hidden py-4 space-y-4"
    >
      <a href="/services" class="block font-body text-neutral-700 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300">
        Services
      </a>
      <a href="/about" class="block font-body text-neutral-700 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300">
        About
      </a>
      <a href="/pricing" class="block font-body text-neutral-700 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300">
        Pricing
      </a>
      <a href="/contact" class="block font-body text-neutral-700 dark:text-neutral-300 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300">
        Contact
      </a>
      <a 
        href="/contact" 
        class="block px-4 py-2 rounded-xl font-body text-center text-white bg-primary-600 hover:bg-primary-700 transition-all duration-300 ease-in-out hover:shadow-glow-sm"
      >
        Get Started
      </a>
    </div>
  </div>
</header>

<script>
  const menuButton = document.getElementById('menuButton');
  const mobileMenu = document.getElementById('mobileMenu');

  menuButton?.addEventListener('click', () => {
    mobileMenu?.classList.toggle('hidden');
  });
</script> 
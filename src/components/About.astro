---
const teamMembers = [
  {
    name: "Max Grüner",
    role: "Gründer & Entwickler",
    description: "Als erfahrener Entwickler bringt Max technische Expertise und innovative Lösungen in jedes Projekt ein.",
    image: "/team/max.png"
  },
  {
    name: "Kürsat",
    role: "Gründer & Designer",
    description: "Kürsat vereint kreatives Design mit strategischem Denken, um einzigartige digitale Erlebnisse zu schaffen.",
    image: "/team/kursat.png"
  }
];
---

<section class="relative py-24 overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0">
    <!-- Base gradient -->
    <div class="absolute inset-0 bg-gradient-to-br from-primary-600/5 via-transparent to-primary-400/5"></div>
    
    <!-- Animated grid with mask -->
    <div class="absolute inset-0">
      <!-- Grid pattern -->
      <div class="absolute inset-0 bg-[linear-gradient(rgba(31,63,255,0.02)_1px,transparent_1px),linear-gradient(to_right,rgba(31,63,255,0.02)_1px,transparent_1px)] bg-[size:3rem_3rem] [transform-style:preserve-3d] animate-grid-fade"></div>
      
      <!-- Gradient mask for grid -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/30 to-white dark:via-neutral-950/30 dark:to-neutral-950"></div>
    </div>
    
    <!-- Decorative elements -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_80%,rgba(31,63,255,0.05)_0%,transparent_40%)]"></div>
    <div class="absolute -left-40 -top-40 w-[500px] h-[500px] rounded-full bg-primary-600/5 blur-3xl"></div>
    <div class="absolute -right-40 -bottom-40 w-[500px] h-[500px] rounded-full bg-primary-600/5 blur-3xl"></div>
  </div>

  <div class="container mx-auto px-4 relative">
    <!-- Section Header -->
    <div class="max-w-3xl mx-auto text-center mb-16" data-aos="fade-up">
      <span class="text-primary-600 dark:text-primary-400 font-medium tracking-wide uppercase text-sm mb-4 bg-primary-100 dark:bg-primary-900/50 px-4 py-2 rounded-full">Das Team</span>
      <h2 class="text-4xl md:text-5xl font-clash font-medium mb-6 text-neutral-900 dark:text-white">
        Die Köpfe hinter MexxMedia
      </h2>
      <p class="text-lg font-inter text-neutral-700 dark:text-neutral-300 leading-relaxed">
        Als junges, dynamisches Duo vereinen wir technische Expertise mit kreativem Design. 
        Gemeinsam gestalten wir digitale Lösungen, die Ihre Ziele erreichen und begeistern.
      </p>
    </div>

    <!-- Team Grid -->
    <div class="max-w-7xl mx-auto grid lg:grid-cols-2 gap-12">
      {teamMembers.map((member) => (
        <div class="group" data-aos="fade-up">
          <div class="h-full p-8 bg-white dark:bg-neutral-900 rounded-2xl shadow-lg dark:shadow-none
                      border border-gray-200 dark:border-neutral-800
                      transition-all duration-300 ease-in-out
                      hover:-translate-y-1 hover:shadow-xl dark:hover:border-primary-500/20">
            <div class="space-y-6">
              <!-- Member Image -->
              <div class="relative rounded-2xl overflow-hidden shadow-xl aspect-[4/3]">
                <div class="absolute inset-0 bg-gradient-to-tr from-primary-600/10 to-transparent mix-blend-overlay"></div>
                <img
                  src={member.image}
                  alt={member.name}
                  class="w-full h-full object-cover"
                />
              </div>

              <!-- Member Info -->
              <div class="space-y-4">
                <div>
                  <h3 class="text-2xl font-clash font-medium text-neutral-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors duration-300">
                    {member.name}
                  </h3>
                  <p class="text-lg font-inter text-neutral-600 dark:text-neutral-400">
                    {member.role}
                  </p>
                </div>
                <p class="text-neutral-700 dark:text-neutral-300 font-inter">
                  {member.description}
                </p>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Stats Grid -->
    <div class="max-w-4xl mx-auto grid grid-cols-3 gap-6 mt-16" data-aos="fade-up">
      <div class="p-6 text-center bg-white dark:bg-neutral-900 rounded-2xl border border-gray-200 dark:border-neutral-800 transition-all duration-300 hover:border-primary-600/30 dark:hover:border-primary-400/30">
        <h3 class="text-3xl font-bold text-primary-600 dark:text-primary-400 mb-2">100+</h3>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">Erfolgreiche Projekte</p>
      </div>
      <div class="p-6 text-center bg-white dark:bg-neutral-900 rounded-2xl border border-gray-200 dark:border-neutral-800 transition-all duration-300 hover:border-primary-600/30 dark:hover:border-primary-400/30">
        <h3 class="text-3xl font-bold text-primary-600 dark:text-primary-400 mb-2">98%</h3>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">Kundenzufriedenheit</p>
      </div>
      <div class="p-6 text-center bg-white dark:bg-neutral-900 rounded-2xl border border-gray-200 dark:border-neutral-800 transition-all duration-300 hover:border-primary-600/30 dark:hover:border-primary-400/30">
        <h3 class="text-3xl font-bold text-primary-600 dark:text-primary-400 mb-2">5+</h3>
        <p class="text-sm text-neutral-600 dark:text-neutral-400">Jahre Erfahrung</p>
      </div>
    </div>

    <!-- CTA -->
    <div class="flex gap-4 justify-center mt-12" data-aos="fade-up">
      <a href="#contact" 
         class="inline-flex items-center justify-center px-6 py-3 rounded-xl font-body text-white bg-primary-600 hover:bg-primary-700 transition-all duration-300 ease-in-out hover:shadow-glow">
        Projekt starten
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
        </svg>
      </a>
      <a href="#services" 
         class="inline-flex items-center justify-center px-6 py-3 rounded-xl font-body text-primary-600 dark:text-primary-400 border border-primary-600 dark:border-primary-400 hover:bg-primary-600/10 dark:hover:bg-primary-400/10 transition-all duration-300 ease-in-out">
        Unsere Leistungen
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
        </svg>
      </a>
    </div>
  </div>
</section> 
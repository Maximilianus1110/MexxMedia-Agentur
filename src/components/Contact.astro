---
const contactInfo = {
  address: "Musterstraße 123, 12345 Musterstadt",
  email: "kontakt@mexxmedia.de",
  phone: "+49 (0) 123 456789",
  socialMedia: [
    {
      name: "LinkedIn",
      url: "#",
      icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`
    },
    {
      name: "Twitter",
      url: "#",
      icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>`
    },
    {
      name: "Facebook",
      url: "#",
      icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>`
    }
  ]
};
---

<section id="contact" class="py-20 bg-neutral-50 dark:bg-[#0A0A0B] relative overflow-hidden">
  <!-- Background Elements -->
  <div class="absolute inset-0 bg-gradient-to-b from-[#F4E8D9]/10 to-transparent dark:from-[#2C2620]/20"></div>
  <div class="absolute top-0 right-0 w-96 h-96 bg-[#F4E8D9]/20 dark:bg-[#2C2620]/20 rounded-full blur-3xl -translate-y-1/2 translate-x-1/2"></div>
  <div class="absolute bottom-0 left-0 w-96 h-96 bg-[#F4E8D9]/10 dark:bg-[#2C2620]/10 rounded-full blur-3xl translate-y-1/2 -translate-x-1/2"></div>

  <div class="container mx-auto px-4 relative">
    <div class="max-w-4xl mx-auto text-center mb-16" data-aos="fade-up">
      <p class="text-[#A48155] dark:text-[#C4A47D] font-medium tracking-wide uppercase text-sm mb-4">Kontakt</p>
      <h2 class="text-4xl md:text-5xl font-serif font-bold mb-6 text-neutral-900 dark:text-neutral-100">
        Lassen Sie uns ins Gespräch kommen
      </h2>
      <p class="text-lg text-neutral-600 dark:text-neutral-400 leading-relaxed">
        Gemeinsam entwickeln wir die perfekte Strategie für Ihre digitale Präsenz
      </p>
    </div>

    <div class="grid md:grid-cols-2 gap-12 max-w-6xl mx-auto">
      <!-- Contact Form -->
      <div class="premium-card p-8" data-aos="fade-right">
        <form class="space-y-6">
          <div>
            <label for="name" class="block text-sm font-medium text-neutral-800 dark:text-neutral-200 mb-2">
              Name
            </label>
            <input
              type="text"
              id="name"
              name="name"
              required
              class="w-full px-4 py-3 rounded-lg bg-[#F4E8D9]/20 dark:bg-[#2C2620]/50 border border-[#A48155]/20 dark:border-[#C4A47D]/20 focus:ring-2 focus:ring-[#A48155] dark:focus:ring-[#C4A47D] focus:border-transparent text-neutral-900 dark:text-white placeholder-neutral-500 dark:placeholder-neutral-400"
              placeholder="Ihr Name"
            />
          </div>
          <div>
            <label for="email" class="block text-sm font-medium text-neutral-800 dark:text-neutral-200 mb-2">
              E-Mail
            </label>
            <input
              type="email"
              id="email"
              name="email"
              required
              class="w-full px-4 py-3 rounded-lg bg-[#F4E8D9]/20 dark:bg-[#2C2620]/50 border border-[#A48155]/20 dark:border-[#C4A47D]/20 focus:ring-2 focus:ring-[#A48155] dark:focus:ring-[#C4A47D] focus:border-transparent text-neutral-900 dark:text-white placeholder-neutral-500 dark:placeholder-neutral-400"
              placeholder="ihre@email.de"
            />
          </div>
          <div>
            <label for="message" class="block text-sm font-medium text-neutral-800 dark:text-neutral-200 mb-2">
              Nachricht
            </label>
            <textarea
              id="message"
              name="message"
              required
              rows="5"
              class="w-full px-4 py-3 rounded-lg bg-[#F4E8D9]/20 dark:bg-[#2C2620]/50 border border-[#A48155]/20 dark:border-[#C4A47D]/20 focus:ring-2 focus:ring-[#A48155] dark:focus:ring-[#C4A47D] focus:border-transparent text-neutral-900 dark:text-white placeholder-neutral-500 dark:placeholder-neutral-400"
              placeholder="Ihre Nachricht an uns..."
            ></textarea>
          </div>
          <button
            type="submit"
            class="button-primary w-full text-lg"
          >
            Nachricht senden
          </button>
        </form>
      </div>

      <!-- Contact Information -->
      <div class="space-y-8" data-aos="fade-left">
        <div class="premium-card p-8">
          <h3 class="text-2xl font-serif font-bold mb-8 text-neutral-900 dark:text-neutral-100">Kontaktinformationen</h3>
          <div class="space-y-6">
            <div class="flex items-start">
              <div class="w-12 h-12 bg-[#F4E8D9] dark:bg-[#2C2620] rounded-xl flex items-center justify-center mr-4
                          group-hover:bg-[#E9D5BB] dark:group-hover:bg-[#3D332B] transition-colors duration-500">
                <svg
                  class="w-6 h-6 text-[#8B6B47] dark:text-[#C4A47D]"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"
                  ></path>
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"
                  ></path>
                </svg>
              </div>
              <div>
                <h4 class="font-medium mb-2 text-neutral-900 dark:text-neutral-100">Adresse</h4>
                <p class="text-neutral-600 dark:text-neutral-400">{contactInfo.address}</p>
              </div>
            </div>
            <div class="flex items-start">
              <div class="w-12 h-12 bg-[#F4E8D9] dark:bg-[#2C2620] rounded-xl flex items-center justify-center mr-4
                          group-hover:bg-[#E9D5BB] dark:group-hover:bg-[#3D332B] transition-colors duration-500">
                <svg
                  class="w-6 h-6 text-[#8B6B47] dark:text-[#C4A47D]"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
                  ></path>
                </svg>
              </div>
              <div>
                <h4 class="font-medium mb-2 text-neutral-900 dark:text-neutral-100">E-Mail</h4>
                <a
                  href={`mailto:${contactInfo.email}`}
                  class="text-[#8B6B47] dark:text-[#C4A47D] hover:text-[#A48155] dark:hover:text-[#C4A47D] transition-colors"
                >
                  {contactInfo.email}
                </a>
              </div>
            </div>
            <div class="flex items-start">
              <div class="w-12 h-12 bg-[#F4E8D9] dark:bg-[#2C2620] rounded-xl flex items-center justify-center mr-4
                          group-hover:bg-[#E9D5BB] dark:group-hover:bg-[#3D332B] transition-colors duration-500">
                <svg
                  class="w-6 h-6 text-[#8B6B47] dark:text-[#C4A47D]"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"
                  ></path>
                </svg>
              </div>
              <div>
                <h4 class="font-medium mb-2 text-neutral-900 dark:text-neutral-100">Telefon</h4>
                <a
                  href={`tel:${contactInfo.phone.replace(/\s/g, '')}`}
                  class="text-[#8B6B47] dark:text-[#C4A47D] hover:text-[#A48155] dark:hover:text-[#C4A47D] transition-colors"
                >
                  {contactInfo.phone}
                </a>
              </div>
            </div>
          </div>

          <div class="mt-10">
            <h4 class="font-medium mb-4 text-neutral-900 dark:text-neutral-100">Folgen Sie uns</h4>
            <div class="flex space-x-6">
              {contactInfo.socialMedia.map((social) => (
                <a
                  href={social.url}
                  class="text-[#8B6B47] dark:text-[#C4A47D] hover:text-[#A48155] dark:hover:text-[#C4A47D] transition-colors"
                  target="_blank"
                  rel="noopener noreferrer"
                  title={social.name}
                >
                  <span class="sr-only">{social.name}</span>
                  <div set:html={social.icon} />
                </a>
              ))}
            </div>
          </div>
        </div>

        <!-- Map -->
        <div class="premium-card p-8">
          <div class="aspect-w-16 aspect-h-9">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2428.409042649056!2d13.404954!3d52.520007!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x0%3A0x0!2zM52wrDMxJzEyLjAiTiAxM8KwMjQnMTcuOCJF!5e0!3m2!1sen!2sde!4v1635784795105!5m2!1sen!2sde"
              class="w-full h-full rounded-lg"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
            ></iframe>
          </div>
        </div>
      </div>
    </div>
  </div>
</section> 
---
const contactInfo = [
  {
    title: "E-Mail",
    value: "info@mexxmedia.de",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
          </svg>`
  },
  {
    title: "Telefon",
    value: "+49 (0) 123 456 789",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z" />
          </svg>`
  },
  {
    title: "Standort",
    value: "München, Deutschland",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
          </svg>`
  }
];
---

<section class="relative py-24 overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0">
    <!-- Base gradient -->
    <div class="absolute inset-0 bg-gradient-to-br from-primary-600/5 via-transparent to-primary-400/5"></div>
    
    <!-- Animated grid with mask -->
    <div class="absolute inset-0">
      <!-- Grid pattern -->
      <div class="absolute inset-0 bg-[linear-gradient(rgba(31,63,255,0.02)_1px,transparent_1px),linear-gradient(to_right,rgba(31,63,255,0.02)_1px,transparent_1px)] bg-[size:3rem_3rem] [transform-style:preserve-3d] animate-grid-fade"></div>
      
      <!-- Gradient mask for grid -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/30 to-white dark:via-neutral-950/30 dark:to-neutral-950"></div>
    </div>
    
    <!-- Decorative elements -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_70%,rgba(31,63,255,0.05)_0%,transparent_40%)]"></div>
    <div class="absolute -right-40 -bottom-40 w-[500px] h-[500px] rounded-full bg-primary-600/5 blur-3xl"></div>
  </div>

  <div class="container mx-auto px-4 relative">
    <div class="max-w-7xl mx-auto">
      <!-- Section Header -->
      <div class="text-center mb-16" data-aos="fade-up">
        <div class="inline-block px-4 py-2 rounded-full text-sm font-medium bg-primary-100 dark:bg-primary-900/50 text-primary-600 dark:text-primary-400 mb-4">
          Kontakt
        </div>
        <h2 class="font-clash text-4xl md:text-5xl lg:text-6xl text-neutral-900 dark:text-white mb-6">
          Lassen Sie uns Ihr Projekt 
          <span class="relative inline-block">
            <span class="relative z-10">besprechen</span>
            <div class="absolute -bottom-2 left-0 right-0 h-3 bg-primary-600/10 dark:bg-primary-400/10 -skew-x-12"></div>
          </span>
        </h2>
        <p class="font-inter text-xl text-neutral-700 dark:text-neutral-300 max-w-2xl mx-auto">
          Wir freuen uns darauf, mehr über Ihre Ziele zu erfahren und gemeinsam die beste Lösung zu entwickeln.
        </p>
      </div>

      <!-- Contact Grid -->
      <div class="grid lg:grid-cols-2 gap-12 items-start">
        <!-- Contact Form -->
        <div class="relative">
          <div class="p-8 bg-white dark:bg-neutral-900 rounded-lg shadow-xl dark:shadow-none border border-gray-200/50 dark:border-neutral-800">
            <form class="space-y-6">
              <div class="grid grid-cols-2 gap-6">
                <!-- Name Field -->
                <div class="col-span-2 sm:col-span-1">
                  <label class="block font-inter text-sm text-neutral-900 dark:text-white mb-2">
                    Name
                  </label>
                  <input
                    type="text"
                    required
                    class="w-full px-4 py-3 rounded-lg bg-neutral-50 dark:bg-neutral-800 
                           border border-gray-200 dark:border-neutral-700
                           font-inter text-neutral-900 dark:text-white
                           focus:ring-2 focus:ring-primary-600/20 dark:focus:ring-primary-400/20
                           focus:border-primary-600 dark:focus:border-primary-400
                           transition-all duration-300"
                    placeholder="Max Mustermann"
                  />
                </div>

                <!-- Email Field -->
                <div class="col-span-2 sm:col-span-1">
                  <label class="block font-inter text-sm text-neutral-900 dark:text-white mb-2">
                    E-Mail
                  </label>
                  <input
                    type="email"
                    required
                    class="w-full px-4 py-3 rounded-lg bg-neutral-50 dark:bg-neutral-800 
                           border border-gray-200 dark:border-neutral-700
                           font-inter text-neutral-900 dark:text-white
                           focus:ring-2 focus:ring-primary-600/20 dark:focus:ring-primary-400/20
                           focus:border-primary-600 dark:focus:border-primary-400
                           transition-all duration-300"
                    placeholder="max@example.com"
                  />
                </div>

                <!-- Subject Field -->
                <div class="col-span-2">
                  <label class="block font-inter text-sm text-neutral-900 dark:text-white mb-2">
                    Betreff
                  </label>
                  <input
                    type="text"
                    required
                    class="w-full px-4 py-3 rounded-lg bg-neutral-50 dark:bg-neutral-800 
                           border border-gray-200 dark:border-neutral-700
                           font-inter text-neutral-900 dark:text-white
                           focus:ring-2 focus:ring-primary-600/20 dark:focus:ring-primary-400/20
                           focus:border-primary-600 dark:focus:border-primary-400
                           transition-all duration-300"
                    placeholder="Ich möchte ein Projekt besprechen"
                  />
                </div>

                <!-- Message Field -->
                <div class="col-span-2">
                  <label class="block font-inter text-sm text-neutral-900 dark:text-white mb-2">
                    Nachricht
                  </label>
                  <textarea
                    required
                    rows="6"
                    class="w-full px-4 py-3 rounded-lg bg-neutral-50 dark:bg-neutral-800 
                           border border-gray-200 dark:border-neutral-700
                           font-inter text-neutral-900 dark:text-white
                           focus:ring-2 focus:ring-primary-600/20 dark:focus:ring-primary-400/20
                           focus:border-primary-600 dark:focus:border-primary-400
                           transition-all duration-300 resize-none"
                    placeholder="Beschreiben Sie Ihr Projekt..."
                  ></textarea>
                </div>
              </div>

              <!-- Submit Button -->
              <button
                type="submit"
                class="w-full inline-flex items-center justify-center px-6 py-4 rounded-xl
                       font-inter text-white bg-primary-600 hover:bg-primary-700
                       transition-all duration-300 ease-out hover:scale-[1.02]
                       focus:outline-none focus:ring-2 focus:ring-primary-600/50
                       shadow-lg shadow-primary-600/10 hover:shadow-xl hover:shadow-primary-600/20"
              >
                <span>Nachricht senden</span>
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
                </svg>
              </button>
            </form>
          </div>

          <!-- Decorative Elements -->
          <div class="absolute -top-4 -right-4 w-24 h-24 bg-primary-600/10 rounded-full blur-2xl"></div>
          <div class="absolute -bottom-8 -left-8 w-32 h-32 bg-primary-400/10 rounded-full blur-2xl"></div>
        </div>

        <!-- Contact Info -->
        <div class="lg:pl-12">
          <!-- Info Cards -->
          <div class="space-y-6">
            {contactInfo.map((info) => (
              <div class="group p-6 bg-white dark:bg-neutral-900 rounded-lg border border-gray-200/50 dark:border-neutral-800 
                          transition-all duration-300 hover:border-primary-600/30 dark:hover:border-primary-400/30
                          hover:shadow-lg hover:shadow-primary-600/5">
                <div class="flex items-start gap-4">
                  <div class="w-12 h-12 rounded-md bg-primary-100 dark:bg-primary-900/50 
                              flex items-center justify-center
                              group-hover:bg-primary-600 dark:group-hover:bg-primary-600
                              transition-colors duration-300">
                    <div class="text-primary-600 dark:text-primary-400 
                                group-hover:text-white dark:group-hover:text-white
                                transition-colors duration-300"
                         set:html={info.icon} />
                  </div>
                  <div>
                    <h3 class="font-clash text-lg text-neutral-900 dark:text-white mb-1">
                      {info.title}
                    </h3>
                    <p class="font-inter text-neutral-700 dark:text-neutral-300">
                      {info.value}
                    </p>
                  </div>
                </div>
              </div>
            ))}
          </div>

          <!-- Additional Info -->
          <div class="mt-12 p-6 bg-primary-50 dark:bg-primary-900/10 rounded-2xl border border-primary-100 dark:border-primary-900/20">
            <h3 class="font-clash text-xl text-neutral-900 dark:text-white mb-4">
              Unsere Bürozeiten
            </h3>
            <div class="space-y-3 font-inter">
              <p class="flex justify-between text-neutral-700 dark:text-neutral-300">
                <span>Montag - Freitag:</span>
                <span>9:00 - 18:00</span>
              </p>
              <p class="flex justify-between text-neutral-700 dark:text-neutral-300">
                <span>Samstag:</span>
                <span>Nach Vereinbarung</span>
              </p>
              <p class="flex justify-between text-neutral-700 dark:text-neutral-300">
                <span>Sonntag:</span>
                <span>Geschlossen</span>
              </p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .animate-float {
    animation: float 3s ease-in-out infinite;
  }
</style>
---
interface Props {
  title: string;
  description: string;
  features: string[];
  additionalFeatures?: string[];
  icon: string;
  href: string;
}

const { title, description, features, additionalFeatures = [], icon, href } = Astro.props;
---

<div class="h-full" x-data="{ expanded: false }">
  <div class="h-full p-8 bg-white dark:bg-neutral-900 rounded-lg shadow-lg dark:shadow-none
              border border-gray-200 dark:border-neutral-800
              transition-all duration-300 ease-in-out relative"
  >
    <!-- Icon & Title -->
    <div class="flex items-start gap-4 mb-6">
      <div class="w-12 h-12 rounded-md bg-primary-100 dark:bg-primary-500/10 flex items-center justify-center
                  group-hover:bg-primary-200 dark:group-hover:bg-primary-500/20 transition-colors duration-300">
        <div class="text-primary-600 dark:text-primary-400" set:html={icon} />
      </div>
      <h3 class="font-display text-xl text-neutral-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors duration-300">
        {title}
      </h3>
    </div>

    <!-- Description -->
    <p class="font-body text-neutral-700 dark:text-neutral-300 mb-8">
      {description}
    </p>

    <!-- Main Features List -->
    <ul class="space-y-4 mb-6">
      {features.map((feature) => (
        <li class="flex items-center text-neutral-700 dark:text-neutral-300">
          <svg class="w-5 h-5 text-primary-600 dark:text-primary-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"></path>
          </svg>
          <span class="font-body group-hover:text-neutral-900 dark:group-hover:text-white transition-colors duration-300">
            {feature}
          </span>
        </li>
      ))}
    </ul>

    <!-- Additional Features (if any) -->
    {additionalFeatures.length > 0 && (
      <div class="relative">
        <!-- Collapsed State -->
        <div x-show="!expanded">
          <div class="absolute bottom-0 left-0 right-0 h-40 bg-gradient-to-b from-transparent to-white dark:to-neutral-900">
            <button 
              @click="expanded = true"
              class="absolute -bottom-2 left-0 right-0 text-center"
            >
              <span class="inline-flex items-center gap-1.5 text-sm text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300">
                Mehr Features anzeigen
                <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </span>
            </button>
          </div>
        </div>

        <!-- Expanded State -->
        <div x-show="expanded" x-collapse>
          <ul class="space-y-4 mb-6">
            {additionalFeatures.map((feature) => (
              <li class="flex items-center text-neutral-700 dark:text-neutral-300">
                <svg class="w-5 h-5 text-primary-600 dark:text-primary-400 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"></path>
                </svg>
                <span class="font-body group-hover:text-neutral-900 dark:group-hover:text-white transition-colors duration-300">
                  {feature}
                </span>
              </li>
            ))}
          </ul>

          <div class="flex justify-between items-center pt-4">
            <a 
              href={href}
              class="inline-block px-4 py-2 text-primary-600 dark:text-primary-400 hover:text-primary-700 dark:hover:text-primary-300 transition-colors duration-300"
            >
              <span class="flex items-center gap-2">
                Mehr erfahren
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                </svg>
              </span>
            </a>
            
            <button 
              @click="expanded = false"
              class="text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300"
            >
              <span class="flex items-center gap-2">
                Features ausblenden
                <svg class="w-4 h-4 transform rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 9l-7 7-7-7"></path>
                </svg>
              </span>
            </button>
          </div>
        </div>
      </div>
    )}
  </div>
</div>

<style>
  [x-cloak] { display: none !important; }
</style> 
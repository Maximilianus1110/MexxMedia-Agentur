---
// No imports needed for now
---

<section id="home" class="relative min-h-screen flex items-center justify-center overflow-hidden py-32">
  <!-- Background gradient -->
  <div class="absolute inset-0 bg-gradient-to-br from-[#F4E8D9]/10 via-transparent to-[#F4E8D9]/5 dark:from-[#2C2620]/20 dark:via-transparent dark:to-[#2C2620]/10"></div>
  
  <!-- Grid background -->
  <div class="absolute inset-0 bg-[linear-gradient(to_right,#A4815510_1px,transparent_1px),linear-gradient(to_bottom,#A4815510_1px,transparent_1px)] dark:bg-[linear-gradient(to_right,#C4A47D10_1px,transparent_1px),linear-gradient(to_bottom,#C4A47D10_1px,transparent_1px)] bg-[size:14px_24px] [mask-image:radial-gradient(ellipse_60%_50%_at_50%_0%,#000_70%,transparent_110%)]"></div>

  <div class="container mx-auto px-4 relative">
    <div class="max-w-4xl mx-auto text-center" data-aos="fade-up">
      <h1 class="text-4xl md:text-6xl font-serif font-bold mb-6 bg-gradient-to-r from-[#8B6B47] to-[#A48155] dark:from-[#C4A47D] dark:to-[#A48155] text-transparent bg-clip-text">
        Ihre digitale Präsenz neu definiert
      </h1>
      <p class="text-xl md:text-2xl text-neutral-600 dark:text-neutral-300 mb-12 leading-relaxed">
        Wir entwickeln maßgeschneiderte Webseiten für Ihr Unternehmen – modern, responsive und perfekt auf Ihre Zielgruppe abgestimmt.
      </p>
      <div class="flex flex-col sm:flex-row items-center justify-center gap-6">
        <a
          href="#contact"
          class="button-primary w-full sm:w-auto text-lg"
        >
          Jetzt Beratung vereinbaren
        </a>
        <a
          href="#services"
          class="button-secondary w-full sm:w-auto text-lg"
        >
          Unsere Leistungen
        </a>
      </div>
    </div>

    <!-- Floating elements -->
    <div class="absolute top-1/4 left-10 w-32 h-32 bg-[#F4E8D9]/20 dark:bg-[#2C2620]/20 rounded-full blur-3xl"></div>
    <div class="absolute bottom-1/4 right-10 w-48 h-48 bg-[#F4E8D9]/10 dark:bg-[#2C2620]/10 rounded-full blur-3xl"></div>
  </div>
</section> 
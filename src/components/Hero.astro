---
import { Image } from 'astro:assets';
import ParticlesEffect from './ParticlesEffect.astro';

const codeExample = `/* Create wow effect */
function createImpact() {
  let design = "modern";
  let tech = "cutting-edge";
  let results = "exceptional";
  
  return {
    implement() {
      design = "innovative";S
      tech = "state-of-art";
      results = "outstanding";
    }
  };
}

// Initialize wow effect
createImpact();`;

interface Props {
  title?: string;
  description?: string;
  ctaText?: string;
  ctaHref?: string;
}

const {
  title = "Ihre digitale Präsenz auf das nächste Level",
  description = "Wir entwickeln maßgeschneiderte Websites, die Ihre Marke perfekt repräsentieren und Ihre Ziele erreichen.",
  ctaText = "Jetzt Projekt starten",
  ctaHref = "/kontakt"
} = Astro.props;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden pt-24 lg:pt-32">
  <!-- Background Effects -->
  <div class="absolute inset-0">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-600/10 via-transparent to-primary-400/10"></div>
    <div class="absolute inset-0 bg-grid-pattern opacity-[0.03] dark:opacity-[0.02]"></div>
  </div>
  
  <!-- Floating Shapes -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none">
    <!-- Top Left Shape -->
    <div 
      class="absolute -top-24 -left-24 w-96 h-96 bg-primary-600/10 rounded-full blur-3xl animate-geometric-float"
      style="animation-delay: -5s;"
    ></div>
    <!-- Bottom Right Shape -->
    <div 
      class="absolute -bottom-24 -right-24 w-96 h-96 bg-primary-400/10 rounded-full blur-3xl animate-geometric-float-reverse"
      style="animation-delay: -2s;"
    ></div>
  </div>

  <div class="container mx-auto px-4 relative">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      <!-- Content -->
      <div class="max-w-2xl">
        <div class="inline-flex items-center px-4 py-2 rounded-full bg-primary-600/10 dark:bg-primary-400/10 text-primary-600 dark:text-primary-400 text-sm font-medium mb-8" data-aos="fade-up">
          <span class="flex w-2 h-2 rounded-full bg-primary-600 dark:bg-primary-400 mr-2"></span>
          Webdesign & Entwicklung
        </div>
        <h1 
          class="font-clash text-4xl md:text-6xl xl:text-7xl font-medium mb-8 leading-tight"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          {title}
        </h1>
        <p 
          class="text-lg md:text-xl text-neutral-600 dark:text-neutral-400 mb-12 leading-relaxed max-w-xl"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          {description}
        </p>
        <div class="flex flex-wrap gap-6" data-aos="fade-up" data-aos-delay="300">
          <a 
            href={ctaHref}
            class="inline-flex items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-full font-medium transition-all duration-300 hover:translate-y-[-2px] hover:shadow-lg"
          >
            {ctaText}
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
          </a>
          <a 
            href="/about"
            class="inline-flex items-center gap-2 bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white px-8 py-4 rounded-full font-medium transition-all duration-300 hover:translate-y-[-2px] hover:shadow-lg border border-neutral-200 dark:border-neutral-800"
          >
            Mehr über uns
            <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M9 18l6-6-6-6"/>
            </svg>
          </a>
        </div>
      </div>

      <!-- Illustration -->
      <div 
        class="hidden lg:block relative"
        data-aos="fade-left"
        data-aos-delay="400"
      >
        <div class="absolute inset-0 bg-gradient-to-br from-primary-600/20 to-primary-400/20 rounded-3xl blur-2xl transform rotate-3"></div>
        <svg class="w-full h-auto relative transform hover:scale-[1.02] hover:rotate-2 transition-transform duration-700" viewBox="0 0 786 786" fill="none" xmlns="http://www.w3.org/2000/svg">
          <!-- Background Circle -->
          <circle cx="393" cy="393" r="393" fill="url(#gradient)" fill-opacity="0.1"/>
          
          <!-- Website Frame -->
          <rect x="193" y="143" width="400" height="500" rx="8" fill="white" class="dark:fill-neutral-900"/>
          <rect x="193" y="143" width="400" height="40" rx="8" fill="#E5E7EB" class="dark:fill-neutral-800"/>
          <circle cx="223" cy="163" r="6" fill="#EF4444"/>
          <circle cx="243" cy="163" r="6" fill="#F59E0B"/>
          <circle cx="263" cy="163" r="6" fill="#10B981"/>
          
          <!-- Content Blocks -->
          <rect x="213" y="203" width="360" height="80" rx="4" fill="#F3F4F6" class="dark:fill-neutral-800"/>
          <rect x="213" y="303" width="160" height="160" rx="4" fill="#F3F4F6" class="dark:fill-neutral-800"/>
          <rect x="393" y="303" width="180" height="160" rx="4" fill="#F3F4F6" class="dark:fill-neutral-800"/>
          <rect x="213" y="483" width="360" height="40" rx="4" fill="#F3F4F6" class="dark:fill-neutral-800"/>
          <rect x="213" y="543" width="360" height="80" rx="4" fill="#F3F4F6" class="dark:fill-neutral-800"/>
          
          <!-- Floating Elements -->
          <circle cx="633" cy="243" r="40" fill="url(#accent1)"/>
          <rect x="153" y="403" width="60" height="60" rx="30" transform="rotate(-15 153 403)" fill="url(#accent2)"/>
          <path d="M673 483l30 52-60 0 30-52z" fill="url(#accent3)"/>
          
          <!-- Gradients -->
          <defs>
            <linearGradient id="gradient" x1="0" y1="0" x2="786" y2="786" gradientUnits="userSpaceOnUse">
              <stop stop-color="#2563EB"/>
              <stop offset="1" stop-color="#60A5FA"/>
            </linearGradient>
            <linearGradient id="accent1" x1="593" y1="203" x2="673" y2="283" gradientUnits="userSpaceOnUse">
              <stop stop-color="#2563EB"/>
              <stop offset="1" stop-color="#60A5FA"/>
            </linearGradient>
            <linearGradient id="accent2" x1="153" y1="403" x2="213" y2="463" gradientUnits="userSpaceOnUse">
              <stop stop-color="#60A5FA"/>
              <stop offset="1" stop-color="#2563EB"/>
            </linearGradient>
            <linearGradient id="accent3" x1="643" y1="483" x2="703" y2="535" gradientUnits="userSpaceOnUse">
              <stop stop-color="#2563EB"/>
              <stop offset="1" stop-color="#60A5FA"/>
            </linearGradient>
          </defs>
        </svg>
      </div>
    </div>
  </div>
</section>

<style>
  .bg-grid-pattern {
    background-image: 
      linear-gradient(to right, currentColor 1px, transparent 1px),
      linear-gradient(to bottom, currentColor 1px, transparent 1px);
    background-size: 4rem 4rem;
  }

  @keyframes geometric-float {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(-20px, 20px) rotate(5deg); }
  }

  @keyframes geometric-float-reverse {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(20px, -20px) rotate(-5deg); }
  }

  @keyframes grid-fade {
    0% { opacity: 0; transform: perspective(1000px) rotateX(10deg); }
    100% { opacity: 1; transform: perspective(1000px) rotateX(0deg); }
  }

  .animate-geometric-float {
    animation: geometric-float 20s ease-in-out infinite;
  }

  .animate-geometric-float-reverse {
    animation: geometric-float-reverse 25s ease-in-out infinite;
  }

  .animate-grid-fade {
    animation: grid-fade 2s ease-out forwards;
  }

  .mix-blend-overlay {
    mix-blend-mode: overlay;
  }
</style> 
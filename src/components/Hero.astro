---
import { Image } from 'astro:assets';
import ParticlesEffect from './ParticlesEffect.astro';

const codeExample = `/* Create wow effect */
function createImpact() {
  let design = "modern";
  let tech = "cutting-edge";
  let results = "exceptional";
  
  return {
    implement() {
      design = "innovative";S
      tech = "state-of-art";
      results = "outstanding";
    }
  };
}

// Initialize wow effect
createImpact();`;
---

<section class="relative min-h-screen flex items-center justify-center overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0">
    <!-- Base gradient -->
    <div class="absolute inset-0 bg-gradient-to-br from-primary-600/10 via-transparent to-primary-400/5"></div>
    
    <!-- Animated grid with mask -->
    <div class="absolute inset-0">
      <!-- Grid pattern -->
      <div class="absolute inset-0 bg-[linear-gradient(rgba(31,63,255,0.03)_1px,transparent_1px),linear-gradient(to_right,rgba(31,63,255,0.03)_1px,transparent_1px)] bg-[size:3rem_3rem] [transform-style:preserve-3d] animate-grid-fade"></div>
      
      <!-- Gradient mask for grid -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/50 to-white dark:via-neutral-950/50 dark:to-neutral-950"></div>
      
      <!-- Additional decorative elements -->
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_20%,rgba(31,63,255,0.1)_0%,transparent_40%)]"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_20%_80%,rgba(31,63,255,0.05)_0%,transparent_30%)]"></div>
    </div>
    
    <!-- Radial gradient overlay -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_50%_50%,rgba(31,63,255,0)_0%,rgba(31,63,255,0.15)_50%,transparent_100%)] opacity-40"></div>
  </div>

  <!-- Floating Elements -->
  <div class="absolute inset-0 overflow-hidden">
    <!-- Geometric shapes -->
    <div class="absolute top-1/4 -right-20 w-[400px] h-[400px] animate-geometric-float">
      <div class="relative w-full h-full">
        <div class="absolute inset-0 bg-gradient-to-br from-primary-400/20 to-transparent rounded-3xl rotate-[30deg] blur-2xl"></div>
        <div class="absolute inset-0 bg-gradient-to-br from-primary-600/20 to-transparent rounded-3xl rotate-45"></div>
      </div>
    </div>
    
    <div class="absolute -bottom-32 -left-16 w-[500px] h-[500px] animate-geometric-float-reverse">
      <div class="relative w-full h-full">
        <div class="absolute inset-0 bg-gradient-to-tr from-primary-600/20 to-transparent rounded-full blur-2xl"></div>
        <div class="absolute inset-0 bg-gradient-to-tr from-primary-400/20 to-transparent rounded-3xl -rotate-12"></div>
      </div>
    </div>
    
    <!-- Additional light effects -->
    <div class="absolute top-1/3 left-1/4 w-64 h-64 bg-primary-400/10 rounded-full blur-3xl mix-blend-overlay"></div>
    <div class="absolute bottom-1/3 right-1/4 w-96 h-96 bg-primary-600/10 rounded-full blur-3xl mix-blend-overlay"></div>
  </div>

  <!-- Content -->
  <div class="container mx-auto px-4 relative">
    <div class="max-w-5xl mx-auto">
      <!-- Main Content -->
      <div class="text-center mb-12">
        <div class="relative inline-block" data-aos="fade-up">
          <span class="inline-block px-4 py-2 rounded-full text-sm font-medium bg-primary-100 dark:bg-primary-900/50 text-primary-600 dark:text-primary-400 mb-6">
            Willkommen bei MexxMedia
          </span>
        </div>
        
        <h1 class="relative font-clash text-5xl md:text-7xl lg:text-8xl font-medium text-neutral-900 dark:text-white mb-8" data-aos="fade-up" data-aos-delay="100">
          <span class="relative inline-block">
            Digitale Lösungen
            <div class="absolute -right-4 top-0 w-3 h-3 rounded-full bg-primary-600 animate-pulse"></div>
          </span>
          <br />
          <span class="relative">
            für Ihren 
            <span class="relative inline-block">
              <span class="relative z-10 text-primary-600 dark:text-primary-400">Erfolg</span>
              <div class="absolute -bottom-2 left-0 right-0 h-3 bg-primary-600/10 dark:bg-primary-400/10 -skew-x-12"></div>
            </span>
          </span>
        </h1>
        
        <p class="font-inter text-xl md:text-2xl text-neutral-700 dark:text-neutral-300 mb-12 max-w-3xl mx-auto leading-relaxed" data-aos="fade-up" data-aos-delay="200">
          Wir entwickeln maßgeschneiderte Webseiten und digitale Strategien, 
          die Ihr Unternehmen auf das nächste Level bringen.
        </p>
      </div>

      <!-- CTA Buttons -->
      <div class="flex flex-col sm:flex-row gap-6 justify-center mb-16" data-aos="fade-up" data-aos-delay="300">
        <a 
          href="#contact" 
          class="group relative inline-flex items-center justify-center px-8 py-4 rounded-2xl font-inter text-white bg-primary-600 hover:bg-primary-700 transition-all duration-300 ease-out hover:scale-105 hover:shadow-lg hover:shadow-primary-600/25"
        >
          <span class="relative z-10">Projekt starten</span>
          <div class="absolute inset-0 rounded-2xl bg-gradient-to-r from-primary-600 to-primary-500 opacity-0 group-hover:opacity-100 transition-opacity duration-300 blur"></div>
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-3 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
        
        <a 
          href="#services" 
          class="group inline-flex items-center justify-center px-8 py-4 rounded-2xl font-inter text-primary-600 dark:text-primary-400 border-2 border-primary-600/20 dark:border-primary-400/20 hover:border-primary-600 dark:hover:border-primary-400 transition-all duration-300 ease-out hover:scale-105"
        >
          Unsere Services
          <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-3 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
          </svg>
        </a>
      </div>

      <!-- Stats Grid -->
      <div class="grid grid-cols-2 md:grid-cols-4 gap-8 max-w-4xl mx-auto" data-aos="fade-up" data-aos-delay="400">
        <div class="text-center">
          <div class="font-clash text-4xl font-medium text-primary-600 dark:text-primary-400 mb-2">100+</div>
          <div class="text-sm text-neutral-600 dark:text-neutral-400">Projekte abgeschlossen</div>
        </div>
        <div class="text-center">
          <div class="font-clash text-4xl font-medium text-primary-600 dark:text-primary-400 mb-2">98%</div>
          <div class="text-sm text-neutral-600 dark:text-neutral-400">Kundenzufriedenheit</div>
        </div>
        <div class="text-center">
          <div class="font-clash text-4xl font-medium text-primary-600 dark:text-primary-400 mb-2">5+</div>
          <div class="text-sm text-neutral-600 dark:text-neutral-400">Jahre Erfahrung</div>
        </div>
        <div class="text-center">
          <div class="font-clash text-4xl font-medium text-primary-600 dark:text-primary-400 mb-2">24/7</div>
          <div class="text-sm text-neutral-600 dark:text-neutral-400">Support & Service</div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mouse Scroll Indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 flex flex-col items-center animate-bounce">
    <div class="w-8 h-14 border-2 border-primary-600/20 dark:border-primary-400/20 rounded-full flex justify-center">
      <div class="w-1.5 h-3 bg-primary-600 dark:bg-primary-400 rounded-full mt-2"></div>
    </div>
    <span class="mt-2 text-sm text-neutral-600 dark:text-neutral-400">Scroll</span>
  </div>
</section>

<style>
  @keyframes geometric-float {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(-20px, 20px) rotate(5deg); }
  }

  @keyframes geometric-float-reverse {
    0%, 100% { transform: translate(0, 0) rotate(0deg); }
    50% { transform: translate(20px, -20px) rotate(-5deg); }
  }

  @keyframes grid-fade {
    0% { opacity: 0; transform: perspective(1000px) rotateX(10deg); }
    100% { opacity: 1; transform: perspective(1000px) rotateX(0deg); }
  }

  .animate-geometric-float {
    animation: geometric-float 20s ease-in-out infinite;
  }

  .animate-geometric-float-reverse {
    animation: geometric-float-reverse 25s ease-in-out infinite;
  }

  .animate-grid-fade {
    animation: grid-fade 2s ease-out forwards;
  }

  .mix-blend-overlay {
    mix-blend-mode: overlay;
  }
</style> 
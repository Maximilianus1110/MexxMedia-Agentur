---
const plans = [
  {
    name: "Starter",
    price: "640",
    description: "Perfekt für kleine Unternehmen und Startups",
    features: [
      "Responsive Website",
      "5 Unterseiten",
      "Kontaktformular",
      "SEO Grundoptimierung",
      "SSL-Verschlüsselung",
      "3 Monate Support"
    ],
    cta: "Starter wählen",
    popular: false
  },
  {
    name: "Professional",
    price: "945",
    description: "Ideal für wachsende Unternehmen",
    features: [
      "Alles aus Starter, plus:",
      "10 Unterseiten",
      "Blog-System",
      "Newsletter-Integration",
      "Social Media Integration",
      "6 Monate Support",
      "Performance Optimierung",
      "Analytics Setup"
    ],
    cta: "Professional wählen",
    popular: true
  },
  {
    name: "Enterprise",
    price: "1.500",
    description: "Maßgeschneiderte Lösungen für große Unternehmen",
    features: [
      "Alles aus Professional, plus:",
      "Unbegrenzte Unterseiten",
      "Custom Design",
      "E-Commerce Integration",
      "API Entwicklung",
      "12 Monate Support",
      "Dedicated Account Manager",
      "24/7 Priority Support"
    ],
    cta: "Enterprise wählen",
    popular: false
  }
];
---

<section class="relative py-24 overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0">
    <!-- Base gradient -->
    <div class="absolute inset-0 bg-gradient-to-br from-primary-600/5 via-transparent to-primary-400/5"></div>
    
    <!-- Animated grid with mask -->
    <div class="absolute inset-0">
      <!-- Grid pattern -->
      <div class="absolute inset-0 bg-[linear-gradient(rgba(31,63,255,0.02)_1px,transparent_1px),linear-gradient(to_right,rgba(31,63,255,0.02)_1px,transparent_1px)] bg-[size:3rem_3rem] [transform-style:preserve-3d] animate-grid-fade"></div>
      
      <!-- Gradient mask for grid -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/30 to-white dark:via-neutral-950/30 dark:to-neutral-950"></div>
    </div>
    
    <!-- Decorative elements -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_70%_30%,rgba(31,63,255,0.05)_0%,transparent_40%)]"></div>
    <div class="absolute -left-40 -bottom-40 w-[500px] h-[500px] rounded-full bg-primary-600/5 blur-3xl"></div>
    <div class="absolute -right-40 top-40 w-[400px] h-[400px] rounded-full bg-primary-600/5 blur-3xl"></div>
  </div>

  <div class="container mx-auto px-4 relative">
    <!-- Section Header -->
    <div class="max-w-4xl mx-auto text-center mb-16">
      <p class="text-primary-600 dark:text-primary-400 font-medium tracking-wide uppercase text-sm mb-4">
        Preise
      </p>
      <h2 class="font-display text-4xl md:text-5xl text-neutral-900 dark:text-white mb-6">
        Transparente Preisgestaltung
      </h2>
      <p class="font-body text-lg text-neutral-700 dark:text-neutral-300">
        Wählen Sie das passende Paket für Ihre Anforderungen
      </p>
    </div>

    <!-- Pricing Grid -->
    <div class="grid md:grid-cols-3 gap-8 max-w-7xl mx-auto">
      {plans.map((plan) => (
        <div class="relative">
          {plan.popular && (
            <div class="absolute -top-4 left-0 right-0 flex justify-center">
              <span class="px-4 py-1 bg-primary-600 text-white text-sm font-medium rounded-lg">
                Beliebt
              </span>
            </div>
          )}
          
          <div class={`h-full p-8 bg-white dark:bg-neutral-900 rounded-lg shadow-lg dark:shadow-none
                       border ${plan.popular ? 'border-primary-600 dark:border-primary-400' : 'border-gray-200 dark:border-neutral-800'}
                       transition-all duration-300 ease-in-out
                       hover:-translate-y-1 hover:shadow-xl`}>
            <!-- Plan Header -->
            <div class="text-center mb-8">
              <h3 class="font-display text-2xl text-neutral-900 dark:text-white mb-4">
                {plan.name}
              </h3>
              <div class="flex items-baseline justify-center mb-4">
                <span class="text-6xl font-display text-neutral-900 dark:text-white">{plan.price}</span>
                <span class="text-4xl font-display text-neutral-900 dark:text-white">€</span>
              </div>
              <p class="font-body text-neutral-700 dark:text-neutral-300">
                {plan.description}
              </p>
            </div>

            <!-- Features List -->
            <ul class="space-y-4 mb-8">
              {plan.features.map((feature) => (
                <li class="flex items-start">
                  <svg class="w-5 h-5 text-primary-600 dark:text-primary-400 mt-1 mr-3 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path>
                  </svg>
                  <span class="font-body text-neutral-700 dark:text-neutral-300">
                    {feature}
                  </span>
                </li>
              ))}
            </ul>

            <!-- CTA Button -->
            <div class="mt-auto">
              <a
                href="/kontakt"
                class={`w-full inline-flex items-center justify-center px-6 py-3 rounded-lg font-body
                        transition-all duration-300 ease-in-out
                        ${plan.popular
                          ? 'text-white bg-primary-600 hover:bg-primary-700 hover:shadow-glow'
                          : 'text-primary-600 dark:text-primary-400 border border-primary-600 dark:border-primary-400 hover:bg-primary-600/10 dark:hover:bg-primary-400/10'
                        }`}
              >
                {plan.cta}
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                </svg>
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Consultation Block -->
    <div class="max-w-3xl mx-auto mt-16 p-8 bg-white dark:bg-neutral-900 rounded-2xl border border-neutral-200/50 dark:border-neutral-800/50 text-center">
      <h3 class="font-display text-2xl text-neutral-900 dark:text-white mb-4">
        Nicht sicher, welches Paket zu dir passt?
      </h3>
      <p class="font-body text-lg text-neutral-700 dark:text-neutral-300 mb-8">
        Kein Problem – wir finden gemeinsam heraus, was du wirklich brauchst und stellen dir ein individuelles Angebot zusammen.
      </p>
      <a
        href="/kontakt"
        class="inline-flex items-center justify-center px-8 py-4 rounded-lg font-body text-white bg-neutral-900 dark:bg-white dark:text-neutral-900
               transition-all duration-300 ease-in-out
               hover:bg-neutral-800 dark:hover:bg-neutral-100 hover:-translate-y-1 hover:shadow-lg"
      >
        Jetzt kostenlos beraten lassen
        <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
        </svg>
      </a>
    </div>

    <!-- FAQ Link -->
    <div class="text-center mt-12">
      <p class="font-body text-neutral-700 dark:text-neutral-300">
        Haben Sie Fragen zu unseren Paketen?{" "}
        <a href="/faq" class="text-primary-600 dark:text-primary-400 hover:underline">
          Besuchen Sie unsere FAQ
        </a>
      </p>
    </div>
  </div>
</section>

<style>
  @keyframes grid-fade {
    0% { opacity: 0; transform: perspective(1000px) rotateX(10deg); }
    100% { opacity: 1; transform: perspective(1000px) rotateX(0deg); }
  }

  .animate-grid-fade {
    animation: grid-fade 2s ease-out forwards;
  }
</style> 
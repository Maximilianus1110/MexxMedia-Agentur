---
import ServiceCard from './ServiceCard.astro';

const services = [
  {
    title: "Webdesign & Entwicklung",
    description: "Moderne, responsive Webseiten mit benutzerfreundlichem Design und optimaler Performance.",
    features: [
      "Responsive Design für alle Geräte",
      "Moderne Technologien & Frameworks",
      "Optimierte Ladezeiten",
      "Barrierefreie Gestaltung"
    ],
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"></path>
          </svg>`,
    href: "/service/webdesign"
  },
  {
    title: "SEO & Content Marketing",
    description: "Optimierung Ihrer Online-Präsenz für bessere Sichtbarkeit in Suchmaschinen.",
    features: [
      "Keyword-Recherche & Strategie",
      "On-Page & Off-Page SEO",
      "Content-Erstellung & Optimierung",
      "Performance-Tracking"
    ],
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>`,
    href: "/service/seo"
  },
  {
    title: "Hosting & Wartung",
    description: "Sicheres Hosting und technische Betreuung – für einen stabilen und stressfreien Betrieb Ihrer Website.",
    features: [
      "Schnelles Hosting mit SSL & Domain",
      "Regelmäßige Backups & Updates",
      "Fehlerbehebung & technischer Support",
      "DSGVO- & Cookie-Management"
    ],
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
             <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 7v10a4 4 0 004 4h10a4 4 0 004-4V7M3 7a4 4 0 014-4h10a4 4 0 014 4M3 7h18"></path>
           </svg>`,
    href: "/service/hosting"
  }
];

---

<section class="relative py-24 overflow-hidden">
  <!-- Background Effects -->
  <div class="absolute inset-0">
    <!-- Base gradient -->
    <div class="absolute inset-0 bg-gradient-to-br from-primary-600/5 via-transparent to-primary-400/5"></div>
    
    <!-- Animated grid with mask -->
    <div class="absolute inset-0">
      <!-- Grid pattern -->
      <div class="absolute inset-0 bg-[linear-gradient(rgba(31,63,255,0.02)_1px,transparent_1px),linear-gradient(to_right,rgba(31,63,255,0.02)_1px,transparent_1px)] bg-[size:3rem_3rem] [transform-style:preserve-3d] animate-grid-fade"></div>
      
      <!-- Gradient mask for grid -->
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/30 to-white dark:via-neutral-950/30 dark:to-neutral-950"></div>
    </div>
    
    <!-- Decorative elements -->
    <div class="absolute inset-0 bg-[radial-gradient(circle_at_80%_20%,rgba(31,63,255,0.05)_0%,transparent_40%)]"></div>
    <div class="absolute -right-40 -top-40 w-[500px] h-[500px] rounded-full bg-primary-600/5 blur-3xl"></div>
    <div class="absolute -left-40 -bottom-40 w-[500px] h-[500px] rounded-full bg-primary-600/5 blur-3xl"></div>
  </div>

  <div class="container mx-auto px-4 relative">
    <!-- Section Header -->
    <div class="max-w-4xl mx-auto text-center mb-16">
      <p class="text-primary-600 dark:text-primary-400 font-medium tracking-wide uppercase text-sm mb-4">
        Unsere Expertise
      </p>
      <h2 class="font-display text-4xl md:text-5xl text-neutral-900 dark:text-white mb-6">
        Unsere Leistungen
      </h2>
      <p class="font-body text-lg text-neutral-700 dark:text-neutral-300">
        Professionelle Lösungen für Ihren digitalen Erfolg
      </p>
    </div>

    <!-- Services Grid -->
    <div class="grid md:grid-cols-3 gap-8">
      {services.map((service) => (
        <ServiceCard {...service} />
      ))}
    </div>

    <!-- CTA Button -->
    <div class="mt-16 text-center">
      <a href="/service" class="inline-block px-8 py-4 rounded-full bg-primary-600 text-white font-medium text-lg hover:bg-primary-700 transition-all duration-300">
        Alle Services entdecken →
      </a>
    </div>
  </div>
</section>

<style>
  .bg-grid {
    transform-style: preserve-3d;
  }

  @keyframes sphere-float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-20px); }
  }

  @keyframes sphere-float-reverse {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(20px); }
  }

  .animate-sphere-float {
    animation: sphere-float 8s ease-in-out infinite;
  }

  .animate-sphere-float-reverse {
    animation: sphere-float-reverse 8s ease-in-out infinite;
  }
</style> 
---
const currentYear = new Date().getFullYear();

const footerLinks = {
  services: [
    { name: "Webdesign", href: "/services#webdesign" },
    { name: "Entwicklung", href: "/services#development" },
    { name: "SEO", href: "/services#seo" },
    { name: "Marketing", href: "/services#marketing" }
  ],
  company: [
    { name: "Über uns", href: "/about" },
    { name: "Team", href: "/team" },
    { name: "Karriere", href: "/careers" },
    { name: "Blog", href: "/blog" }
  ],
  legal: [
    { name: "Impressum", href: "/impressum" },
    { name: "Datenschutz", href: "/datenschutz" },
    { name: "AGB", href: "/agb" }
  ],
  social: [
    {
      name: "Twitter",
      href: "https://twitter.com/mexxmedia",
      icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M8.29 20.251c7.547 0 11.675-6.253 11.675-11.675 0-.178 0-.355-.012-.53A8.348 8.348 0 0022 5.92a8.19 8.19 0 01-2.357.646 4.118 4.118 0 001.804-2.27 8.224 8.224 0 01-2.605.996 4.107 4.107 0 00-6.993 3.743 11.65 11.65 0 01-8.457-4.287 4.106 4.106 0 001.27 5.477A4.072 4.072 0 012.8 9.713v.052a4.105 4.105 0 003.292 4.022 4.095 4.095 0 01-1.853.07 4.108 4.108 0 003.834 2.85A8.233 8.233 0 012 18.407a11.616 11.616 0 006.29 1.84" />
            </svg>`
    },
    {
      name: "LinkedIn",
      href: "https://linkedin.com/company/mexxmedia",
      icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M19 0h-14c-2.761 0-5 2.239-5 5v14c0 2.761 2.239 5 5 5h14c2.762 0 5-2.239 5-5v-14c0-2.761-2.238-5-5-5zm-11 19h-3v-11h3v11zm-1.5-12.268c-.966 0-1.75-.79-1.75-1.764s.784-1.764 1.75-1.764 1.75.79 1.75 1.764-.783 1.764-1.75 1.764zm13.5 12.268h-3v-5.604c0-3.368-4-3.113-4 0v5.604h-3v-11h3v1.765c1.396-2.586 7-2.777 7 2.476v6.759z" />
            </svg>`
    },
    {
      name: "Instagram",
      href: "https://instagram.com/mexxmedia",
      icon: `<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24">
              <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z" />
            </svg>`
    }
  ]
};
---

<footer class="bg-white dark:bg-neutral-950 border-t border-gray-200 dark:border-neutral-900">
  <div class="container mx-auto px-4 py-12 md:py-16">
    <!-- Footer Grid -->
    <div class="grid grid-cols-2 md:grid-cols-12 gap-8 mb-12">
      <!-- Logo & Description -->
      <div class="col-span-2 md:col-span-4">
        <a href="/" class="flex items-center space-x-2 mb-6">
          <img src="/logo.svg" alt="MexxMedia Logo" class="h-8 w-auto" />
          <span class="font-display text-xl text-neutral-900 dark:text-white">
            MexxMedia
          </span>
        </a>
        <p class="font-body text-neutral-600 dark:text-neutral-400 mb-6">
          Wir entwickeln digitale Lösungen, die Ihr Unternehmen voranbringen.
        </p>
        <!-- Social Links -->
        <div class="flex space-x-4">
          {footerLinks.social.map((item) => (
            <a
              href={item.href}
              class="text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300"
              target="_blank"
              rel="noopener noreferrer"
            >
              <span class="sr-only">{item.name}</span>
              <Fragment set:html={item.icon} />
            </a>
          ))}
        </div>
      </div>

      <!-- Services Links -->
      <div class="col-span-1 md:col-span-2">
        <h3 class="font-display text-sm text-neutral-900 dark:text-white uppercase tracking-wider mb-4">
          Services
        </h3>
        <ul class="space-y-3">
          {footerLinks.services.map((item) => (
            <li>
              <a
                href={item.href}
                class="font-body text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Company Links -->
      <div class="col-span-1 md:col-span-2">
        <h3 class="font-display text-sm text-neutral-900 dark:text-white uppercase tracking-wider mb-4">
          Unternehmen
        </h3>
        <ul class="space-y-3">
          {footerLinks.company.map((item) => (
            <li>
              <a
                href={item.href}
                class="font-body text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Legal Links -->
      <div class="col-span-2 md:col-span-4">
        <h3 class="font-display text-sm text-neutral-900 dark:text-white uppercase tracking-wider mb-4">
          Newsletter
        </h3>
        <p class="font-body text-neutral-600 dark:text-neutral-400 mb-4">
          Bleiben Sie auf dem Laufenden über unsere neuesten Projekte und Insights.
        </p>
        <form class="flex gap-2">
          <input
            type="email"
            required
            placeholder="Ihre E-Mail"
            class="flex-1 px-4 py-2 rounded-xl bg-white dark:bg-neutral-900 
                   border border-gray-200 dark:border-neutral-800
                   font-body text-neutral-900 dark:text-white
                   focus:ring-2 focus:ring-primary-600/20 dark:focus:ring-primary-400/20
                   focus:border-primary-600 dark:focus:border-primary-400
                   transition-all duration-300"
          />
          <button
            type="submit"
            class="px-4 py-2 rounded-xl font-body text-white bg-primary-600 
                   hover:bg-primary-700 transition-all duration-300 ease-in-out 
                   hover:shadow-glow-sm"
          >
            Anmelden
          </button>
        </form>
      </div>
    </div>

    <!-- Bottom Bar -->
    <div class="pt-8 border-t border-gray-200 dark:border-neutral-900">
      <div class="flex flex-col md:flex-row justify-between items-center gap-4">
        <p class="font-body text-neutral-600 dark:text-neutral-400 text-sm">
          © {currentYear} MexxMedia. Alle Rechte vorbehalten.
        </p>
        <div class="flex flex-wrap justify-center gap-6">
          {footerLinks.legal.map((item) => (
            <a
              href={item.href}
              class="font-body text-sm text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors duration-300"
            >
              {item.name}
            </a>
          ))}
        </div>
      </div>
    </div>
  </div>
</footer> 
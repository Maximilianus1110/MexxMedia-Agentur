---
const currentYear = new Date().getFullYear();

const footerLinks = {
  services: [
    { name: "Webdesign", href: "/webdesign" },
    { name: "SEO & Marketing", href: "/seo" },
    { name: "Hosting & Wartung", href: "/hosting" }
  ]
};
---

<footer class="bg-white dark:bg-neutral-950 border-t border-gray-200 dark:border-neutral-900">
  <div class="container mx-auto px-4 py-12">
    <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
      <!-- MexxMedia -->
      <div>
        <h3 class="font-display text-lg text-neutral-900 dark:text-white mb-4">
          MexxMedia
        </h3>
        <p class="text-neutral-600 dark:text-neutral-400 text-sm">
          Ihre Webagentur für digitalen Erfolg. Design, SEO und Hosting aus einer Hand.
        </p>
      </div>

      <!-- Services -->
      <div>
        <h3 class="font-display text-lg text-neutral-900 dark:text-white mb-4">
          Services
        </h3>
        <ul class="space-y-2">
          {footerLinks.services.map((item) => (
            <li>
              <a
                href={item.href}
                class="text-sm text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
              >
                {item.name}
              </a>
            </li>
          ))}
        </ul>
      </div>

      <!-- Kontakt -->
      <div>
        <h3 class="font-display text-lg text-neutral-900 dark:text-white mb-4">
          Kontakt
        </h3>
        <ul class="space-y-2 text-sm text-neutral-600 dark:text-neutral-400">
          <li>+49 (0) 123 456789</li>
          <li>info@mexxmedia.de</li>
          <li>Musterstraße 123</li>
          <li>12345 Musterstadt</li>
        </ul>
      </div>

      <!-- Rechtliches -->
      <div>
        <h3 class="font-display text-lg text-neutral-900 dark:text-white mb-4">
          Rechtliches
        </h3>
        <ul class="space-y-2">
          <li>
            <a
              href="/impressum"
              class="text-sm text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              Impressum
            </a>
          </li>
          <li>
            <a
              href="/datenschutz"
              class="text-sm text-neutral-600 dark:text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
            >
              Datenschutz
            </a>
          </li>
        </ul>
      </div>
    </div>

    <!-- Copyright -->
    <div class="mt-12 pt-8 border-t border-gray-200 dark:border-neutral-900 text-center">
      <p class="text-sm text-neutral-600 dark:text-neutral-400">
        © {currentYear} MexxMedia GmbH. Alle Rechte vorbehalten.
      </p>
    </div>
  </div>
</footer> 
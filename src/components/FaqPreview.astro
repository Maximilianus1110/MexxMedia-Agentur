---
interface Props {
  className?: string;
}

const { className = '' } = Astro.props;
---

<section class={`faq-preview ${className}`}>
  <div class="max-w-7xl mx-auto px-4 py-16 sm:px-6 lg:px-8">
    <div class="max-w-3xl mx-auto text-center">
      <h2 class="text-3xl font-bold tracking-tight text-gray-900 dark:text-white sm:text-4xl">
        Noch Fragen?
      </h2>
      <p class="mt-4 text-lg text-gray-600 dark:text-gray-300">
        In unserem FAQ-Bereich finden Sie Antworten auf die häufigsten Fragen zu unseren Dienstleistungen.
      </p>
      <div class="mt-8">
        <a 
          href="/faq" 
          class="inline-flex items-center justify-center px-8 py-4 rounded-full font-medium text-white bg-primary-600 hover:bg-primary-700 transition-all duration-300 hover:scale-105 hover:shadow-lg hover:shadow-primary-600/25 focus:outline-none focus:ring-2 focus:ring-primary-600/50"
        >
          Zum FAQ-Bereich
          <svg 
            class="ml-2 -mr-1 h-5 w-5" 
            xmlns="http://www.w3.org/2000/svg" 
            viewBox="0 0 20 20" 
            fill="currentColor"
          >
            <path fill-rule="evenodd" d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z" clip-rule="evenodd" />
          </svg>
        </a>
      </div>
    </div>
  </div>
</section> 
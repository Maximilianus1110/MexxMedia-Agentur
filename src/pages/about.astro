---
import Layout from '../layouts/Layout.astro';

const team = [
  {
    name: "Max",
    role: "Strategie & Entwicklung",
    quote: "Code ist wie Poesie – er sollte elegant, effizient und verständlich sein.",
    image: "/team/max.png",
    socials: {
      github: "#",
      linkedin: "#"
    }
  },
  {
    name: "Kürsat",
    role: "Design & Kundenkontakt",
    quote: "Design ist nicht nur wie es aussieht, sondern wie es funktioniert.",
    image: "/team/kursat.png",
    socials: {
      behance: "#",
      linkedin: "#"
    }
  }
];

const values = [
  {
    title: "Zukunftsdenken",
    description: "Wir setzen auf moderne Technologien und nachhaltige Lösungen.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>`
  },
  {
    title: "Qualität vor Quantität",
    description: "Jedes Projekt verdient unsere volle Aufmerksamkeit und höchste Standards.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
          </svg>`
  },
  {
    title: "Ehrliche Kommunikation",
    description: "Transparenz und offener Dialog sind die Basis für erfolgreiche Zusammenarbeit.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>`
  }
];

const techStack = [
  { name: "Astro", icon: "🚀" },
  { name: "TailwindCSS", icon: "🎨" },
  { name: "TypeScript", icon: "📘" },
  { name: "Supabase", icon: "⚡" },
  { name: "Vercel", icon: "▲" }
];

const title = "Das Team hinter MexxMedia – Über uns";
const description = "Wer wir sind, wie wir arbeiten, und warum das wirkt.";
---

<Layout 
  title={title}
  description={description}
>
  <!-- Minimalist Hero -->
  <section class="relative min-h-[80vh] flex items-center justify-center">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-b from-primary-600/5 to-transparent"></div>
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_top,_var(--tw-gradient-from)_0%,_transparent_70%)] from-primary-600/[0.03] dark:from-primary-400/[0.03]"></div>
    </div>
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center px-4 py-2 rounded-full bg-primary-600/10 dark:bg-primary-400/10 text-primary-600 dark:text-primary-400 text-sm font-medium mb-8" data-aos="fade-up">
          <span class="flex w-2 h-2 rounded-full bg-primary-600 dark:bg-primary-400 mr-2"></span>
          Über uns
        </div>
        <h1 
          class="font-display text-4xl md:text-6xl lg:text-7xl text-neutral-900 dark:text-white mb-8"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Wir bauen Webseiten,<br/>
          die <span class="text-primary-600 dark:text-primary-400">wirken</span>.
        </h1>
        <p 
          class="text-lg md:text-xl text-neutral-600 dark:text-neutral-400 mb-12 max-w-2xl mx-auto leading-relaxed"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          Als lokale Webagentur aus Nürnberg entwickeln wir digitale Lösungen, 
          die nicht nur gut aussehen, sondern auch Ergebnisse liefern.
        </p>
        <div 
          class="flex flex-wrap items-center justify-center gap-8 text-sm text-neutral-600 dark:text-neutral-400"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
            </svg>
            Nürnberg & Umgebung
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 13.255A23.931 23.931 0 0112 15c-3.183 0-6.22-.62-9-1.745M16 6V4a2 2 0 00-2-2h-4a2 2 0 00-2 2v2m4 6h.01M5 20h14a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
            </svg>
            Seit 2023 am Start
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            +25 erfolgreiche Projekte
          </div>
        </div>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-white dark:from-neutral-950 to-transparent"></div>
  </section>

  <!-- Mission Statement -->
  <section class="py-24 bg-neutral-50 dark:bg-neutral-900/50">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <h2 
          class="font-display text-3xl md:text-5xl lg:text-6xl text-neutral-900 dark:text-white text-center mb-8"
          data-aos="fade-up"
        >
          Warum gibt's MexxMedia?
        </h2>
        <div 
          class="prose dark:prose-invert prose-lg mx-auto text-center"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          <p class="lead text-xl md:text-2xl">
            Wir sind Max & Kürsat – zwei Gründer mit dem Anspruch, bessere Webseiten zu bauen.
            Max bringt technisches Know-how und strategisches Denken mit, Kürsat sorgt für Design, das wirkt.
          </p>
          <p class="text-lg md:text-xl text-neutral-600 dark:text-neutral-400">
            Unsere Mission: Moderne Webauftritte, die lokal überzeugen und digital performen – für kleine und mittelständische Unternehmen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-24">
    <div class="container mx-auto px-4">
      <div class="grid md:grid-cols-2 gap-16 lg:gap-24 max-w-7xl mx-auto">
        {team.map((member, index) => (
          <div 
            class="relative"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <div class="aspect-[3/4] mb-8 overflow-hidden rounded-3xl bg-neutral-100 dark:bg-neutral-900">
              <img 
                src={member.image} 
                alt={member.name}
                class="w-full h-full object-cover"
              />
            </div>
            <div class="relative">
              <h2 class="font-display text-3xl text-neutral-900 dark:text-white mb-2">
                {member.name}
              </h2>
              <p class="text-primary-600 dark:text-primary-400 font-medium mb-6">
                {member.role}
              </p>
              <blockquote class="text-lg text-neutral-600 dark:text-neutral-400 italic mb-6">
                "{member.quote}"
              </blockquote>
              <div class="flex gap-4">
                {Object.entries(member.socials).map(([platform, url]) => (
                  <a 
                    href={url}
                    class="text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="sr-only">Besuche {platform}</span>
                    <i class={`fab fa-${platform} text-xl`}></i>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  

  <!-- CTA Section -->
  <section class="py-32">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 
          class="font-display text-3xl md:text-5xl text-neutral-900 dark:text-white mb-12"
          data-aos="fade-up"
        >
          Bereit für eine Website,<br/>
          die wirklich was <span class="text-primary-600 dark:text-primary-400">bewegt</span>?
        </h2>
        <a 
          href="/kontakt"
          class="inline-flex items-center gap-2 bg-primary-600 hover:bg-primary-700 text-white px-8 py-4 rounded-full font-medium transition-all duration-300 hover:translate-y-[-2px] hover:shadow-lg"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Jetzt Projekt starten
          <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 12h14M12 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .prose {
    max-width: none;
  }
  
  :global(.prose p) {
    margin-top: 1.5em;
    margin-bottom: 1.5em;
  }
</style> 
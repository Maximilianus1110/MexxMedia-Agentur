---
import Layout from '../layouts/Layout.astro';

const team = [
  {
    name: "Max",
    role: "Strategie & Entwicklung",
    funFact: "Always think positive",
    image: "/team/max.jpg",
    socials: {
      linkedin: "#",
      github: "#",
      twitter: "#"
    }
  },
  {
    name: "Kürsat",
    role: "Design & Kundenkontakt",
    funFact: "Starker Blick für visuelle Klarheit",
    image: "/team/kuersat.jpg",
    socials: {
      linkedin: "#",
      behance: "#",
      dribbble: "#"
    }
  }
];

const values = [
  {
    title: "Zukunftsdenken",
    description: "Wir setzen auf moderne Technologien und nachhaltige Lösungen.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>`
  },
  {
    title: "Qualität vor Quantität",
    description: "Jedes Projekt verdient unsere volle Aufmerksamkeit und höchste Standards.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z" />
          </svg>`
  },
  {
    title: "Ehrliche Kommunikation",
    description: "Transparenz und offener Dialog sind die Basis für erfolgreiche Zusammenarbeit.",
    icon: `<svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
          </svg>`
  }
];

const techStack = [
  { name: "Astro", icon: "🚀" },
  { name: "TailwindCSS", icon: "🎨" },
  { name: "TypeScript", icon: "📘" },
  { name: "Supabase", icon: "⚡" },
  { name: "Vercel", icon: "▲" }
];
---

<Layout 
  title="Über uns – MexxMedia | Ihre Webagentur für digitalen Erfolg"
  description="Lernen Sie das Team hinter MexxMedia kennen. Erfahren Sie mehr über unsere Geschichte, Werte und technische Expertise."
>
  <!-- Hero Section with Pattern -->
  <section class="relative py-32 overflow-hidden">
    <div class="absolute inset-0 bg-grid-pattern opacity-5"></div>
    <div class="absolute inset-0 bg-gradient-to-b from-primary-600/10 to-transparent"></div>
    <div class="container relative mx-auto px-4">
      <div class="max-w-4xl mx-auto text-center">
        <h1 class="font-display text-5xl md:text-7xl text-neutral-900 dark:text-white mb-8 leading-tight" data-aos="fade-up">
          Wer wir <span class="text-primary-600 dark:text-primary-400">sind</span>
        </h1>
        <p class="text-xl md:text-2xl text-neutral-600 dark:text-neutral-400 leading-relaxed" data-aos="fade-up" data-aos-delay="100">
          Ein junges Team mit klarem Ziel: Unternehmen digital erfolgreich machen.
        </p>
      </div>
    </div>
    <div class="absolute bottom-0 left-0 right-0 h-24 bg-gradient-to-t from-white dark:from-neutral-950 to-transparent"></div>
  </section>

  <!-- Geschichte Section -->
  <section class="py-24">
    <div class="container mx-auto px-4">
      <div class="max-w-3xl mx-auto">
        <h2 class="font-display text-3xl md:text-5xl text-neutral-900 dark:text-white mb-12 text-center" data-aos="fade-up">
          Unsere Geschichte
        </h2>
        <div class="prose dark:prose-invert prose-lg mx-auto" data-aos="fade-up" data-aos-delay="100">
          <p class="lead text-xl">
            Wir sind Max & Kürsat – zwei Gründer mit dem Anspruch, bessere Webseiten zu bauen.
          </p>
          <p>
            Max bringt technisches Know-how und strategisches Denken mit, Kürsat sorgt für Design, das wirkt.
          </p>
          <p>
            Unsere Mission: Moderne Webauftritte, die lokal überzeugen und digital performen – für kleine und mittelständische Unternehmen.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- Team Section -->
  <section class="py-24 bg-neutral-50 dark:bg-neutral-900/50">
    <div class="container mx-auto px-4">
      <h2 class="font-display text-3xl md:text-5xl text-neutral-900 dark:text-white text-center mb-16" data-aos="fade-up">
        Unser Team
      </h2>
      <div class="grid md:grid-cols-2 gap-12 max-w-4xl mx-auto">
        {team.map((member, index) => (
          <div 
            class="group relative overflow-hidden rounded-3xl bg-white dark:bg-neutral-900 shadow-xl dark:shadow-primary-600/5 transition-all duration-300 hover:-translate-y-2"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <div class="aspect-[4/5] mb-6 overflow-hidden">
              <img 
                src={member.image} 
                alt={member.name}
                class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-110"
              />
            </div>
            <div class="p-8">
              <h3 class="font-display text-2xl text-neutral-900 dark:text-white mb-2">
                {member.name}
              </h3>
              <p class="text-primary-600 dark:text-primary-400 font-medium mb-4">
                {member.role}
              </p>
              <div class="relative overflow-hidden">
                <p class="text-sm text-neutral-500 dark:text-neutral-400 italic mb-6 transform transition-transform duration-300 group-hover:-translate-y-full">
                  {member.funFact}
                </p>
                <p class="text-sm text-neutral-500 dark:text-neutral-400 absolute top-0 left-0 transform translate-y-full transition-transform duration-300 group-hover:translate-y-0">
                  Lieblings-Tools: {member.name === "Max" ? "TypeScript & Astro" : "Figma & TailwindCSS"}
                </p>
              </div>
              <div class="flex gap-4">
                {Object.entries(member.socials).map(([platform, url]) => (
                  <a 
                    href={url}
                    class="text-neutral-400 hover:text-primary-600 dark:hover:text-primary-400 transition-colors"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <span class="sr-only">Besuche {platform}</span>
                    <i class={`fab fa-${platform} text-xl`}></i>
                  </a>
                ))}
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Values Section with Parallax -->
  <section class="py-32 relative overflow-hidden">
    <div class="absolute inset-0 bg-primary-600/5 dark:bg-primary-400/5"></div>
    <div class="container mx-auto px-4 relative">
      <h2 class="font-display text-3xl md:text-5xl text-neutral-900 dark:text-white text-center mb-16" data-aos="fade-up">
        Unsere Werte
      </h2>
      <div class="grid md:grid-cols-3 gap-12 max-w-6xl mx-auto">
        {values.map((value, index) => (
          <div 
            class="relative p-8 rounded-3xl bg-white dark:bg-neutral-900 shadow-xl dark:shadow-primary-600/5"
            data-aos="fade-up"
            data-aos-delay={index * 100}
          >
            <div class="w-16 h-16 mx-auto mb-8 rounded-2xl bg-primary-600/10 dark:bg-primary-400/10 flex items-center justify-center transform -rotate-6 hover:rotate-0 transition-transform duration-300">
              <div class="text-primary-600 dark:text-primary-400 transform rotate-6 group-hover:rotate-0 transition-transform duration-300" set:html={value.icon} />
            </div>
            <h3 class="font-display text-2xl text-neutral-900 dark:text-white text-center mb-4">
              {value.title}
            </h3>
            <p class="text-neutral-600 dark:text-neutral-400 text-center">
              {value.description}
            </p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Tech Stack Section -->
  <section class="py-24">
    <div class="container mx-auto px-4">
      <h2 class="font-display text-3xl md:text-5xl text-neutral-900 dark:text-white text-center mb-16" data-aos="fade-up">
        Unser Tech-Stack
      </h2>
      <div class="flex flex-wrap justify-center gap-6 max-w-4xl mx-auto" data-aos="fade-up" data-aos-delay="100">
        {techStack.map(tech => (
          <div class="group relative">
            <div class="absolute -inset-0.5 bg-gradient-to-r from-primary-600 to-purple-600 rounded-full opacity-0 group-hover:opacity-100 transition duration-300 blur"></div>
            <span class="relative px-6 py-3 rounded-full bg-white dark:bg-neutral-900 text-neutral-900 dark:text-white font-medium flex items-center gap-2 group-hover:translate-y-[-2px] transition duration-300">
              <span class="text-xl">{tech.icon}</span>
              {tech.name}
            </span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- CTA Section -->
  <section class="py-32 relative overflow-hidden">
    <div class="absolute inset-0 bg-gradient-to-br from-primary-600/20 via-purple-600/20 to-primary-600/20 dark:from-primary-400/10 dark:via-purple-400/10 dark:to-primary-400/10"></div>
    <div class="container relative mx-auto px-4">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="font-display text-4xl md:text-6xl text-neutral-900 dark:text-white mb-8" data-aos="fade-up">
          Lernen Sie uns <span class="text-primary-600 dark:text-primary-400">persönlich</span> kennen
        </h2>
        <p class="text-xl text-neutral-600 dark:text-neutral-400 mb-12" data-aos="fade-up" data-aos-delay="100">
          Lassen Sie uns gemeinsam Ihr nächstes digitales Projekt besprechen.
        </p>
        <a 
          href="/kontakt" 
          class="inline-flex items-center px-8 py-4 rounded-full bg-gradient-to-r from-primary-600 to-purple-600 text-white font-medium hover:translate-y-[-2px] transition-all duration-300 shadow-lg hover:shadow-xl"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          Jetzt Kontakt aufnehmen
          <svg class="w-5 h-5 ml-2" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
          </svg>
        </a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .bg-grid-pattern {
    background-image: 
      linear-gradient(to right, rgba(0,0,0,0.1) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(0,0,0,0.1) 1px, transparent 1px);
    background-size: 4rem 4rem;
  }

  .dark .bg-grid-pattern {
    background-image: 
      linear-gradient(to right, rgba(255,255,255,0.1) 1px, transparent 1px),
      linear-gradient(to bottom, rgba(255,255,255,0.1) 1px, transparent 1px);
  }

  :global(.prose) {
    max-width: none;
  }
</style> 
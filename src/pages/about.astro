---
import Layout from '../layouts/Layout.astro';
import Stats from '../components/Stats.astro';
import { siteConfig } from '../data/site.config';
---

<Layout 
	title="Das Team hinter MexxMedia – Über uns"
	description="Wer wir sind, wie wir arbeiten, und warum das wirkt."
>
	<script type="application/ld+json" set:html={JSON.stringify({
		"@context": "https://schema.org",
		"@type": "WebPage",
		"name": "Das Team hinter MexxMedia – Über uns",
		"description": "Wer wir sind, wie wir arbeiten, und warum das wirkt.",
		"publisher": {
			"@type": "Organization",
			"name": "MexxMedia GbR",
			"url": siteConfig.url,
			"logo": new URL(siteConfig.ogImage, siteConfig.url).href
		}
	})} />

	<div class="space-y-24 md:space-y-32 py-24 md:py-32">
		<!-- Main About Section -->
		<section class="container mx-auto px-6 md:px-8">
			<!-- Page Header -->
			<div class="text-center mb-16">
				<h1 class="text-4xl md:text-5xl font-bold font-display text-neutral-800 dark:text-white mb-4">
					Das Team hinter MexxMedia
				</h1>
				<p class="text-lg text-neutral-600 dark:text-neutral-300 max-w-3xl mx-auto">
					Wir sind mehr als nur eine Agentur – wir sind Ihr strategischer Partner für den digitalen Erfolg.
				</p>
			</div>
		</section>

		<Stats />
	</div>

</Layout>

<style>
  .prose {
    max-width: none;
  }
  
  :global(.prose p) {
    margin-top: 1.5em;
    margin-bottom: 1.5em;
  }
</style> 
---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';

const title = "Lass uns starten – MexxMedia";
const description = "Wir freuen uns auf dein Projekt! Erzähl uns ein bisschen davon.";

const packages = [
  { id: 'web-basic', name: 'Web Basic', description: 'Die perfekte Basis für deine Online-Präsenz' },
  { id: 'web-plus', name: 'Web Plus', description: 'Erweiterte Funktionen für mehr Möglichkeiten' },
  { id: 'web-max', name: 'Web Max', description: 'Maximale Performance und alle Features' }
];
---

<Layout title={title} description={description}>
  <!-- Hero Section -->
  <section class="relative py-24 lg:py-32 overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-br from-primary-600/[0.03] to-transparent"></div>
      <div class="absolute right-0 top-1/2 -translate-y-1/2 w-1/2 aspect-square bg-gradient-conic from-primary-600/[0.05] to-transparent rounded-full blur-3xl"></div>
    </div>

    <div class="container mx-auto px-4 relative">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center px-4 py-2 rounded-full bg-primary-600/10 dark:bg-primary-400/10 text-primary-600 dark:text-primary-400 text-sm font-medium mb-8" data-aos="fade-up">
          <span class="flex w-2 h-2 rounded-full bg-primary-600 dark:bg-primary-400 mr-2"></span>
          Projektanfrage
        </div>
        <h1 
          class="font-display text-4xl md:text-6xl lg:text-7xl text-neutral-900 dark:text-white mb-8"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Lass uns <span class="text-primary-600 dark:text-primary-400">starten</span>
        </h1>
        <p 
          class="text-lg md:text-xl text-neutral-600 dark:text-neutral-400 mb-8"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          Wir freuen uns auf dein Projekt! Erzähl uns ein bisschen davon.
        </p>
      </div>
    </div>
  </section>

  <!-- Content Section -->
  <section class="pb-24">
    <div class="container mx-auto px-4">
      <div class="max-w-4xl mx-auto">
        <!-- Package Selection Cards -->
        <div class="grid md:grid-cols-3 gap-6 mb-16">
          {packages.map((pkg) => (
            <label class="relative cursor-pointer group">
              <input 
                type="radio" 
                name="package" 
                value={pkg.id} 
                class="peer absolute opacity-0"
                required
              />
              <div class="h-full p-6 rounded-2xl border-2 border-neutral-200 dark:border-neutral-800 bg-white dark:bg-neutral-900 transition-all duration-300 peer-checked:border-primary-600 dark:peer-checked:border-primary-400 peer-checked:shadow-lg peer-checked:shadow-primary-600/10 hover:border-primary-600/50 dark:hover:border-primary-400/50">
                <div class="flex flex-col h-full">
                  <h3 class="text-xl font-medium text-neutral-900 dark:text-white mb-2">
                    {pkg.name}
                  </h3>
                  <p class="text-neutral-600 dark:text-neutral-400 text-sm mb-4">
                    {pkg.description}
                  </p>
                  <div class="mt-auto">
                    <div class="inline-flex items-center justify-center w-6 h-6 rounded-full border-2 border-neutral-300 dark:border-neutral-700 peer-checked:border-primary-600 dark:peer-checked:border-primary-400 transition-colors">
                      <div class="w-3 h-3 rounded-full bg-primary-600 dark:bg-primary-400 opacity-0 peer-checked:opacity-100 transition-opacity"></div>
                    </div>
                  </div>
                </div>
              </div>
            </label>
          ))}
        </div>

        <!-- Contact Form -->
        <form id="contactForm" class="space-y-8">
          <div class="bg-white dark:bg-neutral-900 p-8 rounded-2xl border border-neutral-200 dark:border-neutral-800">
            <div class="grid md:grid-cols-2 gap-6">
              <!-- Name -->
              <div class="col-span-2 md:col-span-1">
                <label for="name" class="block text-sm font-medium text-neutral-900 dark:text-white mb-2">
                  Name*
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  placeholder="Wie dürfen wir dich nennen?"
                  class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 focus:border-primary-600 dark:focus:border-primary-400 focus:ring-2 focus:ring-primary-600/20 dark:focus:ring-primary-400/20 outline-none transition-colors placeholder:text-neutral-400 dark:placeholder:text-neutral-600"
                />
              </div>

              <!-- Email -->
              <div class="col-span-2 md:col-span-1">
                <label for="email" class="block text-sm font-medium text-neutral-900 dark:text-white mb-2">
                  E-Mail*
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  placeholder="Deine beste E-Mail-Adresse"
                  class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 focus:border-primary-600 dark:focus:border-primary-400 focus:ring-2 focus:ring-primary-600/20 dark:focus:ring-primary-400/20 outline-none transition-colors placeholder:text-neutral-400 dark:placeholder:text-neutral-600"
                />
              </div>

              <!-- Company -->
              <div class="col-span-2 md:col-span-1">
                <label for="company" class="block text-sm font-medium text-neutral-900 dark:text-white mb-2">
                  Firma <span class="text-neutral-500">(optional)</span>
                </label>
                <input
                  type="text"
                  id="company"
                  name="company"
                  placeholder="Falls du ein Unternehmen vertrittst"
                  class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 focus:border-primary-600 dark:focus:border-primary-400 focus:ring-2 focus:ring-primary-600/20 dark:focus:ring-primary-400/20 outline-none transition-colors placeholder:text-neutral-400 dark:placeholder:text-neutral-600"
                />
              </div>

              <!-- Phone -->
              <div class="col-span-2 md:col-span-1">
                <label for="phone" class="block text-sm font-medium text-neutral-900 dark:text-white mb-2">
                  Telefon <span class="text-neutral-500">(optional)</span>
                </label>
                <input
                  type="tel"
                  id="phone"
                  name="phone"
                  placeholder="Falls du lieber telefonierst"
                  class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 focus:border-primary-600 dark:focus:border-primary-400 focus:ring-2 focus:ring-primary-600/20 dark:focus:ring-primary-400/20 outline-none transition-colors placeholder:text-neutral-400 dark:placeholder:text-neutral-600"
                />
              </div>

              <!-- Website -->
              <div class="col-span-2">
                <label for="website" class="block text-sm font-medium text-neutral-900 dark:text-white mb-2">
                  Deine aktuelle Website <span class="text-neutral-500">(optional)</span>
                </label>
                <input
                  type="url"
                  id="website"
                  name="website"
                  placeholder="https://"
                  class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 focus:border-primary-600 dark:focus:border-primary-400 focus:ring-2 focus:ring-primary-600/20 dark:focus:ring-primary-400/20 outline-none transition-colors placeholder:text-neutral-400 dark:placeholder:text-neutral-600"
                />
              </div>

              <!-- Message -->
              <div class="col-span-2">
                <label for="message" class="block text-sm font-medium text-neutral-900 dark:text-white mb-2">
                  Deine Nachricht an uns
                </label>
                <textarea
                  id="message"
                  name="message"
                  rows="4"
                  placeholder="Erzähl uns von deinem Projekt, deinen Wünschen und Vorstellungen"
                  class="w-full px-4 py-3 rounded-xl bg-neutral-50 dark:bg-neutral-800 border border-neutral-200 dark:border-neutral-700 focus:border-primary-600 dark:focus:border-primary-400 focus:ring-2 focus:ring-primary-600/20 dark:focus:ring-primary-400/20 outline-none transition-colors resize-none placeholder:text-neutral-400 dark:placeholder:text-neutral-600"
                ></textarea>
              </div>
            </div>
          </div>

          <!-- Privacy Policy -->
          <div class="flex items-start">
            <div class="flex items-center h-5">
              <input
                id="privacy"
                name="privacy"
                type="checkbox"
                required
                class="w-4 h-4 rounded border-neutral-300 text-primary-600 focus:ring-primary-600/20 dark:focus:ring-primary-400/20"
              />
            </div>
            <label for="privacy" class="ml-3 text-sm text-neutral-600 dark:text-neutral-400">
              Ich stimme der Verarbeitung meiner Daten gemäß <a href="/datenschutz" class="text-primary-600 dark:text-primary-400 hover:underline">Datenschutzerklärung</a> zu.
            </label>
          </div>

          <!-- Submit Button -->
          <div class="flex justify-end">
            <button
              type="submit"
              class="inline-flex items-center justify-center gap-2 bg-primary-600 text-white px-8 py-4 rounded-full font-medium transition-all duration-300 hover:bg-primary-700 hover:scale-[1.02] disabled:opacity-50 disabled:hover:scale-100 disabled:hover:bg-primary-600"
            >
              Anfrage absenden
              <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M5 12h14M12 5l7 7-7 7"/>
              </svg>
            </button>
          </div>
        </form>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Form validation and submission
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    
    if (!form.checkValidity()) {
      form.reportValidity();
      return;
    }

    // Disable submit button
    if (submitButton) {
      submitButton.disabled = true;
    }

    // Here you would typically send the form data to your backend
    const formData = new FormData(form);
    const data = Object.fromEntries(formData);
    
    try {
      // Example: Send data to your API
      // const response = await fetch('/api/contact', {
      //   method: 'POST',
      //   headers: {
      //     'Content-Type': 'application/json',
      //   },
      //   body: JSON.stringify(data),
      // });

      // if (!response.ok) throw new Error('Fehler beim Senden');

      // Success - you might want to show a success message or redirect
      console.log('Form data:', data);
      
      // Optional: Reset form
      form.reset();
      
    } catch (error) {
      console.error('Error:', error);
      // Show error message to user
    } finally {
      // Re-enable submit button
      if (submitButton) {
        submitButton.disabled = false;
      }
    }
  });

  // Package selection highlight
  const packageInputs = document.querySelectorAll('input[name="package"]');
  packageInputs.forEach(input => {
    const card = input.closest('label');
    input.addEventListener('change', () => {
      packageInputs.forEach(otherInput => {
        const otherCard = otherInput.closest('label');
        if (otherCard) {
          otherCard.classList.toggle('ring-2', otherInput === input);
          otherCard.classList.toggle('ring-primary-600', otherInput === input);
          otherCard.classList.toggle('dark:ring-primary-400', otherInput === input);
        }
      });
    });
  });
</script>
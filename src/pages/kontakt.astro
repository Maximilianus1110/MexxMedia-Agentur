---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../data/site';

const title = "Kontakt aufnehmen – MexxMedia";
const description = "Persönlich, schnell & ehrlich. Jetzt unverbindlich anfragen.";

const emailSocial = { name: 'E-Mail', url: `mailto:${SITE.contact.email}`, handle: SITE.contact.email };
const allSocials = [emailSocial, ...SITE.socials];
---

<Layout 
  title={title}
  description={description}
>
  <!-- Hero Section -->
  <section class="relative py-24 lg:py-32 overflow-hidden">
    <div class="absolute inset-0">
      <div class="absolute inset-0 bg-gradient-to-br from-primary-600/[0.03] to-transparent"></div>
      <div class="absolute right-0 top-1/2 -translate-y-1/2 w-1/2 aspect-square bg-gradient-conic from-primary-600/[0.05] to-transparent rounded-full blur-3xl"></div>
    </div>

    <div class="container mx-auto px-4 relative">
      <div class="max-w-3xl mx-auto text-center">
        <div class="inline-flex items-center px-4 py-2 rounded-full bg-primary-600/10 dark:bg-primary-400/10 text-primary-600 dark:text-primary-400 text-sm font-medium mb-8" data-aos="fade-up">
          <span class="flex w-2 h-2 rounded-full bg-primary-600 dark:bg-primary-400 mr-2"></span>
          Kontakt
        </div>
        <h1 
          class="font-display text-4xl md:text-6xl lg:text-7xl text-neutral-900 dark:text-white mb-8"
          data-aos="fade-up"
          data-aos-delay="100"
        >
          Lassen Sie uns <span class="text-primary-600 dark:text-primary-400">reden</span>
        </h1>
        <p 
          class="text-lg md:text-xl text-neutral-600 dark:text-neutral-400 mb-8"
          data-aos="fade-up"
          data-aos-delay="200"
        >
          Egal ob Sie eine neue Website planen, Ihr bestehendes Design auffrischen möchten oder Fragen haben – wir sind für Sie da.
        </p>
        <div 
          class="flex flex-wrap gap-4 justify-center items-center text-sm text-neutral-600 dark:text-neutral-400"
          data-aos="fade-up"
          data-aos-delay="300"
        >
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Kostenlose Erstberatung</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
            </svg>
            <span>Schnelle Antwortzeiten</span>
          </div>
          <div class="flex items-center gap-2">
            <svg class="w-5 h-5 text-primary-600 dark:text-primary-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 8h2a2 2 0 012 2v6a2 2 0 01-2 2h-2v4l-4-4H9a1.994 1.994 0 01-1.414-.586m0 0L11 14h4a2 2 0 002-2V6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2v4l.586-.586z"/>
            </svg>
            <span>Individuelle Beratung</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Contact Section -->
  <section class="py-24">
    <div class="container mx-auto px-4">
      <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 max-w-7xl mx-auto">
        <!-- Contact Form -->
        <div class="relative" data-aos="fade-up">
          <div class="mb-12">
            <h2 class="font-display text-2xl md:text-3xl text-neutral-900 dark:text-white mb-4">
              Wie können wir Ihnen helfen?
            </h2>
            <p class="text-neutral-600 dark:text-neutral-400">
              Füllen Sie das Formular aus und wir melden uns innerhalb von 24 Stunden bei Ihnen zurück. Alternativ können Sie uns auch direkt über einen der Kanäle rechts kontaktieren.
            </p>
          </div>

          <form 
            id="contactForm" 
            class="space-y-8"
            action="https://formspree.io/f/xeoalzro"
            method="POST"
          >
            <!-- Honeypot field -->
            <div class="hidden">
              <input type="text" name="_gotcha" tabindex="-1" autocomplete="off" />
            </div>

            <!-- Hidden package field -->
            <input type="hidden" name="package" value="Allgemeine Anfrage" />

            <div>
              <label for="name" class="block text-sm font-medium text-neutral-900 dark:text-white mb-2">
                Name
              </label>
              <input
                type="text"
                id="name"
                name="name"
                required
                placeholder="Max Mustermann"
                class="w-full px-4 py-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 focus:border-primary-600 dark:focus:border-primary-400 focus:ring-2 focus:ring-primary-600/20 dark:focus:ring-primary-400/20 outline-none transition-colors placeholder:text-neutral-400 dark:placeholder:text-neutral-600"
              />
            </div>

            <div>
              <label for="email" class="block text-sm font-medium text-neutral-900 dark:text-white mb-2">
                E-Mail
              </label>
              <input
                type="email"
                id="email"
                name="email"
                required
                placeholder="max@beispiel.de"
                class="w-full px-4 py-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 focus:border-primary-600 dark:focus:border-primary-400 focus:ring-2 focus:ring-primary-600/20 dark:focus:ring-primary-400/20 outline-none transition-colors placeholder:text-neutral-400 dark:placeholder:text-neutral-600"
              />
            </div>

            <div>
              <label for="subject" class="block text-sm font-medium text-neutral-900 dark:text-white mb-2">
                Betreff
              </label>
              <input
                type="text"
                id="subject"
                name="subject"
                placeholder="Website-Redesign"
                class="w-full px-4 py-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 focus:border-primary-600 dark:focus:border-primary-400 focus:ring-2 focus:ring-primary-600/20 dark:focus:ring-primary-400/20 outline-none transition-colors placeholder:text-neutral-400 dark:placeholder:text-neutral-600"
              />
            </div>

            <div>
              <label for="message" class="block text-sm font-medium text-neutral-900 dark:text-white mb-2">
                Nachricht / Projektbeschreibung
              </label>
              <textarea
                id="message"
                name="message"
                rows="6"
                placeholder="Beschreiben Sie kurz Ihr Projekt oder Ihre Anfrage. Zum Beispiel: Ich möchte meine bestehende Website modernisieren und suche dafür professionelle Unterstützung..."
                class="w-full px-4 py-3 rounded-xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 focus:border-primary-600 dark:focus:border-primary-400 focus:ring-2 focus:ring-primary-600/20 dark:focus:ring-primary-400/20 outline-none transition-colors resize-none placeholder:text-neutral-400 dark:placeholder:text-neutral-600"
              ></textarea>
            </div>

            <div class="flex items-start">
              <div class="flex items-center h-5">
                <input
                  id="privacy"
                  name="privacy"
                  type="checkbox"
                  required
                  class="w-4 h-4 rounded border-neutral-300 text-primary-600 focus:ring-primary-600/20 dark:focus:ring-primary-400/20"
                />
              </div>
              <label for="privacy" class="ml-3 text-sm text-neutral-600 dark:text-neutral-400">
                Ich stimme der Verarbeitung meiner Daten gemäß <a href="/datenschutz" class="text-primary-600 dark:text-primary-400 hover:underline">Datenschutzerklärung</a> zu.
              </label>
            </div>

            <button
              type="submit"
              disabled
              id="submitButton"
              class="inline-flex items-center gap-2 bg-primary-600 text-white px-8 py-4 rounded-full font-medium transition-all duration-300 hover:bg-primary-700 disabled:opacity-50 disabled:cursor-not-allowed disabled:hover:bg-primary-600"
            >
              <span class="text-loading hidden">
                <svg class="animate-spin h-5 w-5 mr-3" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24">
                  <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
                  <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path>
                </svg>
                Wird gesendet...
              </span>
              <span class="text-default">
                Nachricht senden
                <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M5 12h14M12 5l7 7-7 7"/>
                </svg>
              </span>
            </button>
          </form>
        </div>

        <!-- Contact Options -->
        <div class="lg:pl-8" data-aos="fade-up" data-aos-delay="100">
          <h2 class="font-display text-2xl md:text-3xl text-neutral-900 dark:text-white mb-8">
            Oder kontaktieren Sie uns direkt
          </h2>
          <div class="space-y-6">
            <!-- E-Mail -->
            <a 
              href={`mailto:${SITE.contact.email}`}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-6 p-6 rounded-2xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 hover:border-primary-600 dark:hover:border-primary-400 transition-colors group"
            >
              <div class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-xl bg-primary-600/10 dark:bg-primary-400/10 text-primary-600 dark:text-primary-400 group-hover:bg-primary-600 dark:group-hover:bg-primary-400 group-hover:text-white transition-colors">
                <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <div class="text-sm text-neutral-600 dark:text-neutral-400">
                  E-Mail
                </div>
                <div class="font-medium text-neutral-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                  {SITE.contact.email}
                </div>
              </div>
            </a>

            <!-- WhatsApp -->
            <a 
              href={SITE.socials.find(s => s.name === 'WhatsApp')?.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-6 p-6 rounded-2xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 hover:border-primary-600 dark:hover:border-primary-400 transition-colors group"
            >
              <div class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-xl bg-primary-600/10 dark:bg-primary-400/10 text-primary-600 dark:text-primary-400 group-hover:bg-primary-600 dark:group-hover:bg-primary-400 group-hover:text-white transition-colors">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
                </svg>
              </div>
              <div>
                <div class="text-sm text-neutral-600 dark:text-neutral-400">
                  WhatsApp
                </div>
                <div class="font-medium text-neutral-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                  {SITE.contact.phone}
                </div>
              </div>
            </a>

            <!-- Instagram -->
            <a 
              href={SITE.socials.find(s => s.name === 'Instagram')?.url}
              target="_blank"
              rel="noopener noreferrer"
              class="flex items-center gap-6 p-6 rounded-2xl bg-white dark:bg-neutral-900 border border-neutral-200 dark:border-neutral-800 hover:border-primary-600 dark:hover:border-primary-400 transition-colors group"
            >
              <div class="flex-shrink-0 w-12 h-12 flex items-center justify-center rounded-xl bg-primary-600/10 dark:bg-primary-400/10 text-primary-600 dark:text-primary-400 group-hover:bg-primary-600 dark:group-hover:bg-primary-400 group-hover:text-white transition-colors">
                <svg class="w-6 h-6" fill="currentColor" viewBox="0 0 24 24">
                  <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                </svg>
              </div>
              <div>
                <div class="text-sm text-neutral-600 dark:text-neutral-400">
                  Instagram
                </div>
                <div class="font-medium text-neutral-900 dark:text-white group-hover:text-primary-600 dark:group-hover:text-primary-400 transition-colors">
                  @{SITE.contact.instagram}
                </div>
              </div>
            </a>
          </div>

          <!-- Additional Info -->
          <div class="mt-12 p-6 rounded-2xl bg-neutral-50 dark:bg-neutral-800/50">
            <h3 class="font-display text-lg text-neutral-900 dark:text-white mb-4">
              Warum Sie uns kontaktieren sollten
            </h3>
            <ul class="space-y-4 text-neutral-600 dark:text-neutral-400">
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 dark:text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Kostenlose und unverbindliche Erstberatung</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 dark:text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Individuelle Lösungen für Ihr Unternehmen</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 dark:text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Langjährige Erfahrung in der Webentwicklung</span>
              </li>
              <li class="flex items-start gap-3">
                <svg class="w-5 h-5 text-primary-600 dark:text-primary-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
                <span>Persönliche Betreuung und schnelle Reaktionszeiten</span>
              </li>
            </ul>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>

<script>
  // Enable submit button when privacy checkbox is checked
  const privacyCheckbox = document.getElementById('privacy') as HTMLInputElement;
  const submitButton = document.getElementById('submitButton') as HTMLButtonElement;
  const form = document.getElementById('contactForm') as HTMLFormElement;
  const loadingText = submitButton?.querySelector('.text-loading');
  const defaultText = submitButton?.querySelector('.text-default');

  privacyCheckbox?.addEventListener('change', () => {
    if (submitButton) {
      submitButton.disabled = !privacyCheckbox.checked;
    }
  });

  // Handle form submission
  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    if (submitButton && loadingText && defaultText) {
      // Show loading state
      submitButton.disabled = true;
      loadingText.classList.remove('hidden');
      defaultText.classList.add('hidden');

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          body: new FormData(form),
          headers: {
            'Accept': 'application/json'
          }
        });

        if (response.ok) {
          // Show success message
          const successModal = document.createElement('div');
          successModal.className = 'fixed inset-0 flex items-center justify-center z-50 bg-black/50';
          successModal.innerHTML = `
            <div class="bg-white dark:bg-neutral-900 p-8 rounded-2xl max-w-md mx-4 text-center">
              <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-green-100 dark:bg-green-900/30 flex items-center justify-center">
                <svg class="w-8 h-8 text-green-600 dark:text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                </svg>
              </div>
              <h3 class="text-2xl font-display text-neutral-900 dark:text-white mb-4">
                Nachricht erfolgreich gesendet!
              </h3>
              <p class="text-neutral-600 dark:text-neutral-400 mb-8">
                Vielen Dank für Ihre Nachricht. Wir melden uns innerhalb von 24 Stunden bei Ihnen.
              </p>
              <button class="px-6 py-3 bg-neutral-100 dark:bg-neutral-800 rounded-lg text-neutral-900 dark:text-white hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors">
                Schließen
              </button>
            </div>
          `;

          document.body.appendChild(successModal);
          form.reset();
          
          successModal.querySelector('button')?.addEventListener('click', () => {
            successModal.remove();
            submitButton.disabled = !privacyCheckbox.checked;
            loadingText.classList.add('hidden');
            defaultText.classList.remove('hidden');
          });
        } else {
          throw new Error('Fehler beim Senden der Nachricht');
        }
      } catch (error) {
        // Show error message with retry button
        const errorModal = document.createElement('div');
        errorModal.className = 'fixed inset-0 flex items-center justify-center z-50 bg-black/50';
        errorModal.innerHTML = `
          <div class="bg-white dark:bg-neutral-900 p-8 rounded-2xl max-w-md mx-4 text-center">
            <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-red-100 dark:bg-red-900/30 flex items-center justify-center">
              <svg class="w-8 h-8 text-red-600 dark:text-red-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
              </svg>
            </div>
            <h3 class="text-2xl font-display text-neutral-900 dark:text-white mb-4">
              Ein Fehler ist aufgetreten
            </h3>
            <p class="text-neutral-600 dark:text-neutral-400 mb-8">
              Bitte versuchen Sie es später erneut oder kontaktieren Sie uns direkt.
            </p>
            <div class="flex gap-4 justify-center">
              <button class="retry-button px-6 py-3 bg-primary-600 text-white rounded-lg hover:bg-primary-700 transition-colors">
                Erneut versuchen
              </button>
              <button class="close-button px-6 py-3 bg-neutral-100 dark:bg-neutral-800 rounded-lg text-neutral-900 dark:text-white hover:bg-neutral-200 dark:hover:bg-neutral-700 transition-colors">
                Schließen
              </button>
            </div>
          </div>
        `;

        document.body.appendChild(errorModal);
        
        errorModal.querySelector('.retry-button')?.addEventListener('click', () => {
          errorModal.remove();
          submitButton.disabled = !privacyCheckbox.checked;
          loadingText.classList.add('hidden');
          defaultText.classList.remove('hidden');
        });

        errorModal.querySelector('.close-button')?.addEventListener('click', () => {
          errorModal.remove();
        });
      }
    }
  });
</script> 
        size: "120m²"
      }
    ]
  },
  {
    id: "clinic",
    title: "Premium Care Munich",
    subtitle: "Ihre private Fachklinik für moderne Medizin",
    cta: "Beratung vereinbaren",
    style: "bg-[url('/examples/modern-clinic.jpg')] bg-cover bg-center before:absolute before:inset-0 before:bg-gradient-to-br before:from-emerald-900/70 before:to-emerald-950/70 before:backdrop-blur-[2px] after:absolute after:inset-0 after:bg-[url('/examples/pattern-light.svg')] after:opacity-5",

---
import Layout from '../../layouts/Layout.astro';
import ProcessTimeline from '../../components/ProcessTimeline.astro';

const painPoints = [
  {
    stat: "94%",
    text: "der Website-Besucher bilden ihren ersten Eindruck basierend auf dem Design",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M2.458 12C3.732 7.943 7.523 5 12 5c4.478 0 8.268 2.943 9.542 7-1.274 4.057-5.064 7-9.542 7-4.477 0-8.268-2.943-9.542-7z"></path>
          </svg>`
  },
  {
    stat: "75%",
    text: "der Nutzer beurteilen die Vertrauenswürdigkeit eines Unternehmens anhand der Website",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
          </svg>`
  },
  {
    stat: "3.5s",
    text: "maximale Ladezeit, bevor 50% der Nutzer die Website verlassen",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>`
  }
];

const features = [
  {
    title: "Maßgeschneiderte Designs",
    description: "Individuell auf Ihre Marke und Zielgruppe abgestimmte Designs, die sich von der Masse abheben.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 4a2 2 0 114 0v1a1 1 0 001 1h3a1 1 0 011 1v3a1 1 0 01-1 1h-1a2 2 0 100 4h1a1 1 0 011 1v3a1 1 0 01-1 1h-3a1 1 0 01-1-1v-1a2 2 0 10-4 0v1a1 1 0 01-1 1H7a1 1 0 01-1-1v-3a1 1 0 00-1-1H4a2 2 0 110-4h1a1 1 0 001-1V7a1 1 0 011-1h3a1 1 0 001-1V4z"></path>
          </svg>`
  },
  {
    title: "Mobile-First Strategie",
    description: "Optimale Darstellung auf allen Geräten durch responsive Design und mobile-first Entwicklung.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 18h.01M8 21h8a2 2 0 002-2V5a2 2 0 00-2-2H8a2 2 0 00-2 2v14a2 2 0 002 2z"></path>
          </svg>`
  },
  {
    title: "SEO-optimierte Struktur",
    description: "Von Grund auf für Suchmaschinen optimiert – für bessere Rankings und mehr organische Besucher.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
          </svg>`
  },
  {
    title: "Schnelle Ladezeiten",
    description: "Performance-optimierte Websites mit minimalen Ladezeiten für maximale Conversion-Raten.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M13 10V3L4 14h7v7l9-11h-7z"></path>
          </svg>`
  },
  {
    title: "Barrierefreiheit",
    description: "WCAG-konforme Entwicklung für maximale Zugänglichkeit und Inklusion aller Nutzer.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path>
          </svg>`
  },
  {
    title: "Modernste Technologien",
    description: "Einsatz von State-of-the-Art Frameworks wie Astro und Tailwind für zukunftssichere Lösungen.",
    icon: `<svg class="w-8 h-8" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>`
  }
];

const process = [
  {
    step: 1,
    title: "Analyse & Beratung",
    subtitle: "Anforderungen & Ziele",
    description: "Wir verstehen Ihre Ziele, analysieren Ihre Zielgruppe und entwickeln eine maßgeschneiderte Strategie.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2m-3 7h3m-3 4h3m-6-4h.01M9 16h.01" />
          </svg>`
  },
  {
    step: 2,
    title: "Konzept & Design",
    subtitle: "Wireframes & UI/UX",
    description: "Erstellung von Wireframes und Design-Konzepten, die Ihre Markenidentität perfekt widerspiegeln.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z" />
          </svg>`
  },
  {
    step: 3,
    title: "Entwicklung",
    subtitle: "Technische Umsetzung",
    description: "Entwicklung Ihrer Website mit modernsten Technologien und Best Practices.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 20l4-16m4 4l4 4-4 4M6 16l-4-4 4-4" />
          </svg>`
  },
  {
    step: 4,
    title: "Tests & Optimierung",
    subtitle: "QA & Performance",
    description: "Umfangreiche Tests auf allen Geräten und Optimierung von Performance und UX.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" />
          </svg>`
  },
  {
    step: 5,
    title: "Launch & Support",
    subtitle: "Go-Live & Betreuung",
    description: "Professioneller Launch Ihrer Website und kontinuierliche Unterstützung danach.",
    icon: `<svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z" />
          </svg>`
  }
];

const title = "Webdesign für Unternehmen – MexxMedia";
const description = "Individuelles Design, schnelle Ladezeiten & Mobile First.";
---

<Layout 
  title={title}
  description={description}
>
  <main>
    <!-- Hero Section -->
    <section class="relative min-h-[60vh] flex items-center justify-center overflow-hidden">
      <!-- Background Pattern -->
      <div class="absolute inset-0">
        <div class="absolute inset-0 bg-gradient-to-br from-primary-600/5 via-transparent to-primary-400/5"></div>
        <div class="absolute inset-0">
          <div class="absolute inset-0 bg-[linear-gradient(rgba(31,63,255,0.02)_1px,transparent_1px),linear-gradient(to_right,rgba(31,63,255,0.02)_1px,transparent_1px)] bg-[size:3rem_3rem] [transform-style:preserve-3d] animate-grid-fade"></div>
          <div class="absolute inset-0 bg-gradient-to-b from-transparent via-white/30 to-white dark:via-neutral-950/30 dark:to-neutral-950"></div>
        </div>
      </div>

      <div class="container mx-auto px-4 relative py-24">
        <div class="max-w-4xl mx-auto text-center">
          <h1 class="font-clash text-4xl md:text-5xl lg:text-6xl text-neutral-900 dark:text-white mb-6" data-aos="fade-up">
            Individuelles Webdesign, das überzeugt.
          </h1>
          <p class="font-inter text-xl text-neutral-700 dark:text-neutral-300 mb-12 leading-relaxed" data-aos="fade-up" data-aos-delay="100">
            Wir gestalten digitale Erlebnisse, die nicht nur gut aussehen – sondern Ergebnisse bringen.
          </p>
          <a 
            href="/kontakt" 
            class="inline-flex items-center justify-center px-8 py-4 rounded-full
                   font-inter text-lg text-white bg-primary-600
                   transition-all duration-300 ease-out
                   hover:scale-105 hover:shadow-lg hover:shadow-primary-600/25
                   focus:outline-none focus:ring-2 focus:ring-primary-600/50"
            data-aos="fade-up"
            data-aos-delay="200"
          >
            Jetzt unverbindlich anfragen
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>

    <!-- Pain Points Section -->
    <section class="relative py-24 overflow-hidden">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="font-clash text-3xl md:text-4xl text-neutral-900 dark:text-white mb-6" data-aos="fade-up">
            Warum professionelles Webdesign wichtig ist
          </h2>
          <p class="font-inter text-lg text-neutral-700 dark:text-neutral-300 max-w-3xl mx-auto" data-aos="fade-up" data-aos-delay="100">
            In der digitalen Welt entscheiden Sekundenbruchteile über Erfolg oder Misserfolg. Ein professionelles Webdesign ist der Schlüssel zu mehr Conversions.
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {painPoints.map((point, index) => (
            <div 
              class="bg-white dark:bg-neutral-900 rounded-xl p-8 border border-neutral-200/50 dark:border-neutral-800/50 
                     transition-all duration-300 hover:-translate-y-1 hover:shadow-lg dark:hover:border-primary-500/20"
              data-aos="fade-up"
              data-aos-delay={index * 100}
            >
              <div class="w-16 h-16 rounded-lg bg-primary-100 dark:bg-primary-900/50 
                          flex items-center justify-center mb-6">
                <div class="text-primary-600 dark:text-primary-400" set:html={point.icon} />
              </div>
              <div class="font-clash text-3xl text-primary-600 dark:text-primary-400 mb-2">
                {point.stat}
              </div>
              <p class="font-inter text-neutral-700 dark:text-neutral-300">
                {point.text}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Features Grid -->
    <section class="relative py-24 overflow-hidden bg-gradient-to-b from-white to-neutral-50 dark:from-neutral-950 dark:to-black">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="font-clash text-3xl md:text-4xl text-neutral-900 dark:text-white mb-6" data-aos="fade-up">
            Was Sie von uns erwarten können
          </h2>
          <p class="font-inter text-lg text-neutral-700 dark:text-neutral-300 max-w-3xl mx-auto" data-aos="fade-up" data-aos-delay="100">
            Modernes Webdesign ist mehr als nur schöne Optik. Wir vereinen Design, Technik und Strategie für Ihren Erfolg.
          </p>
        </div>

        <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-8">
          {features.map((feature, index) => (
            <div 
              class="bg-white dark:bg-neutral-900 rounded-xl p-8 border border-neutral-200/50 dark:border-neutral-800/50 
                     transition-all duration-300 hover:-translate-y-1 hover:shadow-lg dark:hover:border-primary-500/20"
              data-aos="fade-up"
              data-aos-delay={index * 100}
            >
              <div class="w-12 h-12 rounded-lg bg-primary-100 dark:bg-primary-900/50 
                          flex items-center justify-center mb-6">
                <div class="text-primary-600 dark:text-primary-400" set:html={feature.icon} />
              </div>
              <h3 class="font-clash text-xl text-neutral-900 dark:text-white mb-3">
                {feature.title}
              </h3>
              <p class="font-inter text-neutral-700 dark:text-neutral-300">
                {feature.description}
              </p>
            </div>
          ))}
        </div>
      </div>
    </section>

    <!-- Process Section -->
    <section class="relative py-24 overflow-hidden">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="font-clash text-3xl md:text-4xl text-neutral-900 dark:text-white mb-6" data-aos="fade-up">
            So arbeiten wir
          </h2>
          <p class="font-inter text-lg text-neutral-700 dark:text-neutral-300 max-w-3xl mx-auto" data-aos="fade-up" data-aos-delay="100">
            Von der ersten Idee bis zum erfolgreichen Launch – wir begleiten Sie durch den gesamten Prozess.
          </p>
        </div>

        <ProcessTimeline steps={process} />
      </div>
    </section>

    <!-- Example Section -->
    <section class="relative py-24 overflow-hidden bg-gradient-to-b from-white to-neutral-50 dark:from-neutral-950 dark:to-black">
      <div class="container mx-auto px-4">
        <div class="text-center mb-16">
          <h2 class="font-clash text-3xl md:text-4xl text-neutral-900 dark:text-white mb-6" data-aos="fade-up">
            So könnte Ihre neue Website aussehen
          </h2>
          <p class="font-inter text-lg text-neutral-700 dark:text-neutral-300 max-w-3xl mx-auto" data-aos="fade-up" data-aos-delay="100">
            Moderne Designs, die Ihre Marke perfekt in Szene setzen und Ihre Besucher begeistern.
          </p>
        </div>

        <div class="max-w-5xl mx-auto" data-aos="fade-up" data-aos-delay="200">
          <div class="aspect-video bg-neutral-200 dark:bg-neutral-800 rounded-xl"></div>
        </div>
      </div>
    </section>

    <!-- Final CTA -->
    <section class="relative py-24 overflow-hidden">
      <div class="container mx-auto px-4">
        <div class="max-w-4xl mx-auto text-center">
          <h2 class="font-clash text-4xl md:text-5xl text-neutral-900 dark:text-white mb-8" data-aos="fade-up">
            Bereit loszulegen?
          </h2>
          <a 
            href="/kontakt" 
            class="inline-flex items-center justify-center px-8 py-4 rounded-full
                   font-inter text-lg text-white bg-primary-600
                   transition-all duration-300 ease-out
                   hover:scale-105 hover:shadow-lg hover:shadow-primary-600/25
                   focus:outline-none focus:ring-2 focus:ring-primary-600/50"
            data-aos="fade-up"
            data-aos-delay="100"
          >
            Jetzt Projekt starten
            <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5 ml-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14 5l7 7m0 0l-7 7m7-7H3" />
            </svg>
          </a>
        </div>
      </div>
    </section>
  </main>
</Layout> 
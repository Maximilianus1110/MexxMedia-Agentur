<script>
  import { gsap } from "gsap";
  import { ScrollTrigger } from "gsap/ScrollTrigger";

  gsap.registerPlugin(ScrollTrigger);

  // Wait for the page to load
  window.addEventListener("load", () => {
    const container = document.querySelector("#examples-container");
    if (!container) return;

    // Get all example cards including the CTA
    const cards = [...document.querySelectorAll("[id^='example-']")];
    
    // Set initial state
    gsap.set(cards[0], { opacity: 1 }); // First card visible immediately
    gsap.set(cards.slice(1), { opacity: 0 }); // Other cards hidden

    // Create the scroll trigger
    ScrollTrigger.create({
      trigger: container,
      start: "top top",
      end: "bottom bottom",
      pin: ".sticky",
      anticipatePin: 1,
      scrub: 1,
      onUpdate: (self) => {
        const progress = self.progress;
        const totalCards = cards.length;
        const cardDuration = 1 / totalCards;

        cards.forEach((card, index) => {
          const cardStart = index * cardDuration;
          const cardEnd = (index + 1) * cardDuration;
          const cardProgress = (progress - cardStart) / cardDuration;

          if (progress >= cardStart && progress <= cardEnd) {
            gsap.to(card, { 
              opacity: 1,
              duration: 0.5
            });
          } else {
            gsap.to(card, { 
              opacity: 0,
              duration: 0.5
            });
          }
        });
      }
    });
  });
</script>

<style>
  @keyframes float {
    0%, 100% { transform: translateY(0); }
    50% { transform: translateY(-10px); }
  }

  .animate-float {
    animation: float 3s ease-in-out infinite;
  }

  /* Ensure smooth scrolling */
  html {
    scroll-behavior: smooth;
  }

  /* Hide scrollbar but keep functionality */
  #examples-container {
    scrollbar-width: none; /* Firefox */
    -ms-overflow-style: none; /* IE and Edge */
  }

  #examples-container::-webkit-scrollbar {
    display: none; /* Chrome, Safari, Opera */
  }
</style> 